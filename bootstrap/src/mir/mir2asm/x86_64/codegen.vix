#[no_main]

pub fn mir2asm_begin_function(b: &MirAsm, line: string)
{
    let at = mir2asm_find(line, '@', 0)
    let lp = mir2asm_find(line, '(', at)
    if (at < 0 or lp < 0) { return }
    b.names = []
    b.offsets = []
    b.is_addr = []
    b.slot_tys = []
    b.param_names = []
    b.param_tys = []
    b.param_regs = []
    b.stack_next = 0
    b.in_fn = 1
    b.fn_name = mir2asm_clean_name(mir2asm_slice(line, at, lp))
    b.ret_label = b.fn_name + "__return"
    mir2asm_line(b, "global " + b.fn_name)
    mir2asm_line(b, b.fn_name + ":")
    mir2asm_line(b, "    push rbp")
    mir2asm_line(b, "    mov rbp, rsp")
    mir2asm_line(b, "    sub rsp, 4096")
    let rp = mir2asm_find(line, ')', lp)
    let mut pos = lp + 1
    let mut arg = 0
    while (rp > 0 and pos < rp)
    {
        if (line[pos] == '%')
        {
            let colon = mir2asm_find(line, ':', pos)
            if (colon > pos and colon < rp)
            {
                let mut ty_end = mir2asm_find(line, ',', colon)
                if (ty_end < 0 or ty_end > rp) { ty_end = rp }
                let param_ty = mir2asm_trim(mir2asm_slice(line, colon + 1, ty_end))
                b.param_names.push(mir2asm_clean_name(mir2asm_slice(line, pos, colon)))
                b.param_tys.push(param_ty)
                b.param_regs.push(mir2asm_arg_reg_typed(arg, param_ty))
                arg += 1
                pos = ty_end
            }
        }
        pos += 1
    }
}

pub fn mir2asm_end_function(b: &MirAsm)
{
    if (b.in_fn == 0) { return }
    mir2asm_line(b, b.ret_label + ":")
    mir2asm_line(b, "    mov rsp, rbp")
    mir2asm_line(b, "    pop rbp")
    mir2asm_line(b, "    ret")
    b.in_fn = 0
}

pub fn mir2asm_emit_binop(b: &MirAsm, dest: string, rhs: string, op: string, asm_op: string)
{
    let start = op.length + 1
    let sp = mir2asm_find(rhs, ' ', start)
    let comma = mir2asm_find(rhs, ',', sp)
    if (sp < 0 or comma < 0) { return }
    let ty = mir2asm_trim(mir2asm_slice(rhs, start, sp))
    let left = mir2asm_trim(mir2asm_slice(rhs, sp + 1, comma))
    let right = mir2asm_trim(mir2asm_after(rhs, comma + 1))
    mir2asm_alloc_slot_typed(b, dest, 0, ty)
    let acc = mir2asm_acc(ty)
    mir2asm_line(b, "    mov " + acc + ", " + mir2asm_operand_typed(b, left, ty))
    if (op == "sdiv" or op == "srem")
    {
        if (mir2asm_type_is_64(ty) == 1) { mir2asm_line(b, "    cqo") }
        else { mir2asm_line(b, "    cdq") }
        mir2asm_line(b, "    mov " + mir2asm_cx(ty) + ", " + mir2asm_operand_typed(b, right, ty))
        mir2asm_line(b, "    idiv " + mir2asm_cx(ty))
        if (op == "srem") { mir2asm_line(b, "    mov " + acc + ", " + mir2asm_dx(ty)) }
    }
    elif (op == "shl" or op == "ashr")
    {
        mir2asm_line(b, "    mov ecx, " + mir2asm_operand_typed(b, right, "i32"))
        mir2asm_line(b, "    " + asm_op + " " + acc + ", cl")
    }
    else
    {
        mir2asm_line(b, "    " + asm_op + " " + acc + ", " + mir2asm_operand_typed(b, right, ty))
    }
    mir2asm_line(b, "    mov " + mir2asm_mem(b.offsets[mir2asm_find_name(b, dest)]) + ", " + acc)
}

pub fn mir2asm_emit_unary(b: &MirAsm, dest: string, rhs: string, op: string, asm_op: string)
{
    let start = op.length + 1
    let sp = mir2asm_find(rhs, ' ', start)
    if (sp < 0) { return }
    let ty = mir2asm_trim(mir2asm_slice(rhs, start, sp))
    let val = mir2asm_trim(mir2asm_after(rhs, sp + 1))
    mir2asm_alloc_slot_typed(b, dest, 0, ty)
    let acc = mir2asm_acc(ty)
    mir2asm_line(b, "    mov " + acc + ", " + mir2asm_operand_typed(b, val, ty))
    mir2asm_line(b, "    " + asm_op + " " + acc)
    mir2asm_line(b, "    mov " + mir2asm_mem(b.offsets[mir2asm_find_name(b, dest)]) + ", " + acc)
}

pub fn mir2asm_emit_cast(b: &MirAsm, dest: string, rhs: string)
{
    let p1 = mir2asm_find(rhs, ' ', 0)
    if (p1 < 0) { return }
    let op = mir2asm_trim(mir2asm_slice(rhs, 0, p1))
    let rest = mir2asm_trim(mir2asm_after(rhs, p1 + 1))
    let p2 = mir2asm_find(rest, ' ', 0)
    let to_pos = mir2asm_find(rest, ' ', p2 + 1)
    if (p2 < 0 or to_pos < 0) { return }
    let from_ty = mir2asm_trim(mir2asm_slice(rest, 0, p2))
    let val = mir2asm_trim(mir2asm_slice(rest, p2 + 1, to_pos))
    let to_ty = mir2asm_trim(mir2asm_after(rest, to_pos + 4))
    mir2asm_alloc_slot_typed(b, dest, 0, to_ty)
    if (op == "zext")
    {
        mir2asm_line(b, "    mov eax, " + mir2asm_operand_typed(b, val, from_ty))
        if (mir2asm_type_is_64(to_ty) == 1) { mir2asm_line(b, "    mov " + mir2asm_mem(b.offsets[mir2asm_find_name(b, dest)]) + ", rax") }
        else { mir2asm_line(b, "    mov " + mir2asm_mem(b.offsets[mir2asm_find_name(b, dest)]) + ", eax") }
        return
    }
    mir2asm_line(b, "    mov " + mir2asm_acc(to_ty) + ", " + mir2asm_operand_typed(b, val, from_ty))
    mir2asm_line(b, "    mov " + mir2asm_mem(b.offsets[mir2asm_find_name(b, dest)]) + ", " + mir2asm_acc(to_ty))
}

pub fn mir2asm_emit_gep(b: &MirAsm, dest: string, rhs: string)
{
    let comma1 = mir2asm_find(rhs, ',', 0)
    let comma2 = mir2asm_find(rhs, ',', comma1 + 1)
    let lb = mir2asm_find(rhs, '[', comma2)
    let rb = mir2asm_find(rhs, ']', lb)
    if (comma1 < 0 or comma2 < 0 or lb < 0 or rb < 0) { return }
    let ty = mir2asm_trim(mir2asm_slice(rhs, 4, comma1))
    let base = mir2asm_trim(mir2asm_slice(rhs, comma1 + 1, comma2))
    let index = mir2asm_trim(mir2asm_slice(rhs, lb + 1, rb))
    let comma_idx = mir2asm_find(index, ',', 0)
    let idx_val = if (comma_idx >= 0) { mir2asm_trim(mir2asm_after(index, comma_idx + 1)) } else { index }
    let base_ty = mir2asm_slot_ty(b, base)
    let elem_ty = if (base_ty == "string" and ty == "i32") { "i8" } else { ty }
    let elem_size = mir2asm_type_size(elem_ty)
    mir2asm_alloc_slot_typed(b, dest, 0, "ptr:" + elem_ty)
    mir2asm_line(b, "    mov rax, " + mir2asm_operand_typed(b, base, "ptr"))
    mir2asm_line(b, "    mov rcx, " + mir2asm_operand_typed(b, idx_val, "i32"))
    if (elem_size != 1) { mir2asm_line(b, "    imul rcx, " + i32_to_str(elem_size)) }
    mir2asm_line(b, "    add rax, rcx")
    mir2asm_line(b, "    mov " + mir2asm_mem(b.offsets[mir2asm_find_name(b, dest)]) + ", rax")
}

pub fn mir2asm_emit_icmp(b: &MirAsm, dest: string, rhs: string)
{
    let mut p = mir2asm_find(rhs, ' ', 0)
    if (p < 0) { return }
    let rest = mir2asm_trim(mir2asm_after(rhs, p + 1))
    p = mir2asm_find(rest, ' ', 0)
    if (p < 0) { return }
    let pred = mir2asm_trim(mir2asm_slice(rest, 0, p))
    let typed = mir2asm_trim(mir2asm_after(rest, p + 1))
    p = mir2asm_find(typed, ' ', 0)
    let comma = mir2asm_find(typed, ',', p)
    if (p < 0 or comma < 0) { return }
    let ty = mir2asm_trim(mir2asm_slice(typed, 0, p))
    let left = mir2asm_trim(mir2asm_slice(typed, p + 1, comma))
    let right = mir2asm_trim(mir2asm_after(typed, comma + 1))
    mir2asm_alloc_slot_typed(b, dest, 0, "i32")
    mir2asm_line(b, "    mov " + mir2asm_acc(ty) + ", " + mir2asm_operand_typed(b, left, ty))
    mir2asm_line(b, "    cmp " + mir2asm_acc(ty) + ", " + mir2asm_operand_typed(b, right, ty))
    mir2asm_line(b, "    " + mir2asm_icmp_setcc(pred) + " al")
    mir2asm_line(b, "    movzx eax, al")
    mir2asm_line(b, "    mov " + mir2asm_mem(b.offsets[mir2asm_find_name(b, dest)]) + ", eax")
}

pub fn mir2asm_emit_syscall(b: &MirAsm, dest: string, rhs: string)
{
    let lp = mir2asm_find(rhs, '(', 0)
    let rp = mir2asm_find(rhs, ')', lp)
    if (lp < 0 or rp < 0) { return }
    let mut pos = lp + 1
    let mut arg = 0
    while (pos < rp and arg < 7)
    {
        let comma = mir2asm_find(rhs, ',', pos)
        let end = if (comma < 0 or comma > rp) { rp } else { comma }
        let part = mir2asm_trim(mir2asm_slice(rhs, pos, end))
        let sp = mir2asm_find(part, ' ', 0)
        if (sp >= 0)
        {
            let arg_ty = mir2asm_trim(mir2asm_slice(part, 0, sp))
            let val = mir2asm_trim(mir2asm_after(part, sp + 1))
            mir2asm_line(b, "    mov " + mir2asm_syscall_reg(arg) + ", " + mir2asm_operand_typed(b, val, arg_ty))
            arg += 1
        }
        pos = end + 1
    }
    mir2asm_line(b, "    syscall")
    if (dest != "") { mir2asm_line(b, "    mov " + mir2asm_mem(mir2asm_alloc_slot_typed(b, dest, 0, "i64")) + ", rax") }
}

pub fn mir2asm_emit_call(b: &MirAsm, dest: string, rhs: string)
{
    let at = mir2asm_find(rhs, '@', 0)
    let lp = mir2asm_find(rhs, '(', at)
    if (at < 0 or lp < 0) { return }
    let func = mir2asm_clean_name(mir2asm_slice(rhs, at, lp))
    if (func == "syscall")
    {
        mir2asm_emit_syscall(b, dest, rhs)
        return
    }
    let rp = mir2asm_find(rhs, ')', lp)
    let mut pos = lp + 1
    let mut arg = 0
    while (rp > 0 and pos < rp and arg < 6)
    {
        let comma = mir2asm_find(rhs, ',', pos)
        let end = if (comma < 0 or comma > rp) { rp } else { comma }
        let part = mir2asm_trim(mir2asm_slice(rhs, pos, end))
        let sp = mir2asm_find(part, ' ', 0)
        if (sp >= 0)
        {
            let arg_ty = mir2asm_trim(mir2asm_slice(part, 0, sp))
            let val = mir2asm_trim(mir2asm_after(part, sp + 1))
            mir2asm_line(b, "    mov " + mir2asm_arg_reg_typed(arg, arg_ty) + ", " + mir2asm_operand_typed(b, val, arg_ty))
            arg += 1
        }
        pos = end + 1
    }
    mir2asm_line(b, "    call " + func)
    if (dest != "")
    {
        let colon = mir2asm_find(rhs, ':', rp)
        let ret_ty = if (colon >= 0) { mir2asm_trim(mir2asm_after(rhs, colon + 1)) } else { "i32" }
        mir2asm_line(b, "    mov " + mir2asm_mem(mir2asm_alloc_slot_typed(b, dest, 0, ret_ty)) + ", " + mir2asm_acc(ret_ty))
    }
}

pub fn mir2asm_emit_instruction(b: &MirAsm, line: string)
{
    if (line == "" or mir2asm_starts_with(line, "mir_module") == 1 or line == "{") { return }
    if (mir2asm_starts_with(line, "extern") == 1)
    {
        let at = mir2asm_find(line, '@', 0)
        let lp = mir2asm_find(line, '(', at)
        let name = if (at >= 0 and lp > at) { mir2asm_clean_name(mir2asm_slice(line, at, lp)) } else { "" }
        if (name != "" and name != "syscall") { mir2asm_line(b, "extern " + name) }
        return
    }
    if (mir2asm_starts_with(line, "fn @") == 1)
    {
        mir2asm_begin_function(b, line)
        return
    }
    if (line == "}")
    {
        mir2asm_end_function(b)
        return
    }
    if (b.in_fn == 0) { return }
    if (mir2asm_starts_with(line, "block ") == 1)
    {
        let name = mir2asm_trim(mir2asm_slice(line, 6, line.length - 1))
        if (name != "%entry") { mir2asm_line(b, mir2asm_label(b, name) + ":") }
        return
    }
    if (mir2asm_starts_with(line, "ret void") == 1)
    {
        mir2asm_line(b, "    jmp " + b.ret_label)
        return
    }
    if (mir2asm_starts_with(line, "ret ") == 1)
    {
        let rest = mir2asm_trim(mir2asm_after(line, 4))
        let sp = mir2asm_find(rest, ' ', 0)
        let ty = if (sp >= 0) { mir2asm_trim(mir2asm_slice(rest, 0, sp)) } else { "i32" }
        let val = if (sp >= 0) { mir2asm_trim(mir2asm_after(rest, sp + 1)) } else { "0" }
        mir2asm_line(b, "    mov " + mir2asm_acc(ty) + ", " + mir2asm_operand_typed(b, val, ty))
        mir2asm_line(b, "    jmp " + b.ret_label)
        return
    }
    if (mir2asm_starts_with(line, "br label ") == 1)
    {
        mir2asm_line(b, "    jmp " + mir2asm_label(b, mir2asm_trim(mir2asm_after(line, 9))))
        return
    }
    if (mir2asm_starts_with(line, "br_cond ") == 1)
    {
        let c1 = mir2asm_find(line, ',', 0)
        let c2 = mir2asm_find(line, ',', c1 + 1)
        if (c1 > 0 and c2 > c1)
        {
            let cond = mir2asm_trim(mir2asm_slice(line, 8, c1))
            let true_label = mir2asm_trim(mir2asm_after(mir2asm_trim(mir2asm_slice(line, c1 + 1, c2)), 6))
            let false_label = mir2asm_trim(mir2asm_after(mir2asm_trim(mir2asm_after(line, c2 + 1)), 6))
            mir2asm_line(b, "    cmp " + mir2asm_operand_typed(b, cond, "i32") + ", 0")
            mir2asm_line(b, "    je " + mir2asm_label(b, false_label))
            mir2asm_line(b, "    jmp " + mir2asm_label(b, true_label))
        }
        return
    }
    if (mir2asm_starts_with(line, "store ") == 1)
    {
        let comma = mir2asm_find(line, ',', 0)
        let sp = mir2asm_find(line, ' ', 6)
        if (comma > 0 and sp > 0)
        {
            let ty = mir2asm_trim(mir2asm_slice(line, 6, sp))
            let val = mir2asm_trim(mir2asm_slice(line, sp + 1, comma))
            let addr = mir2asm_trim(mir2asm_after(line, comma + 1))
            mir2asm_line(b, "    mov " + mir2asm_acc(ty) + ", " + mir2asm_operand_typed(b, val, ty))
            let addr_idx = mir2asm_find_name(b, addr)
            if (addr_idx >= 0 and b.is_addr[addr_idx] == 1)
            {
                mir2asm_line(b, "    mov " + mir2asm_mem_word(ty) + " " + mir2asm_mem(b.offsets[addr_idx]) + ", " + mir2asm_acc(ty))
                if (ty == "ptr" and mir2asm_slot_ty(b, val) == "string") { b.slot_tys[addr_idx] = "string" }
            }
            else
            {
                mir2asm_line(b, "    mov r11, " + mir2asm_operand_typed(b, addr, "ptr"))
                mir2asm_line(b, "    mov " + mir2asm_mem_word(ty) + " [r11], " + mir2asm_acc(ty))
            }
        }
        return
    }
    if (mir2asm_starts_with(line, "call ") == 1)
    {
        mir2asm_emit_call(b, "", line)
        return
    }
    let dest = mir2asm_dest(line)
    let rhs = mir2asm_rhs(line)
    if (dest == "") { return }
    if (mir2asm_starts_with(rhs, "alloca ") == 1)
    {
        mir2asm_alloc_slot_typed(b, dest, 1, mir2asm_trim(mir2asm_after(rhs, 7)))
        return
    }
    if (mir2asm_starts_with(rhs, "load ") == 1)
    {
        let comma = mir2asm_find(rhs, ',', 0)
        if (comma > 0)
        {
            let ty = mir2asm_trim(mir2asm_slice(rhs, 5, comma))
            let addr = mir2asm_trim(mir2asm_after(rhs, comma + 1))
            let addr_idx = mir2asm_find_name(b, addr)
            let addr_ty = if (addr_idx >= 0) { b.slot_tys[addr_idx] } else { "" }
            let src_ty = if (addr_ty == "ptr:i8" and ty == "i32") { "i8" } elif (addr_idx >= 0 and b.is_addr[addr_idx] == 1 and (addr_ty == "ptr" or addr_ty == "string") and ty == "i32") { addr_ty } else { ty }
            let dest_ty = if (src_ty == "i8" and ty == "i32") { "i32" } else { src_ty }
            if (addr_idx >= 0 and b.is_addr[addr_idx] == 1)
            {
                mir2asm_line(b, "    mov " + mir2asm_acc(src_ty) + ", " + mir2asm_mem_word(src_ty) + " " + mir2asm_mem(b.offsets[addr_idx]))
            }
            else
            {
                mir2asm_line(b, "    mov rax, " + mir2asm_operand_typed(b, addr, "ptr"))
                if (src_ty == "i8")
                {
                    mir2asm_line(b, "    movzx eax, byte [rax]")
                }
                else
                {
                    mir2asm_line(b, "    mov " + mir2asm_acc(src_ty) + ", " + mir2asm_mem_word(src_ty) + " [rax]")
                }
            }
            mir2asm_line(b, "    mov " + mir2asm_mem(mir2asm_alloc_slot_typed(b, dest, 0, dest_ty)) + ", " + mir2asm_acc(dest_ty))
        }
        return
    }
    if (mir2asm_starts_with(rhs, "add ") == 1) { mir2asm_emit_binop(b, dest, rhs, "add", "add"); return }
    if (mir2asm_starts_with(rhs, "sub ") == 1) { mir2asm_emit_binop(b, dest, rhs, "sub", "sub"); return }
    if (mir2asm_starts_with(rhs, "mul ") == 1) { mir2asm_emit_binop(b, dest, rhs, "mul", "imul"); return }
    if (mir2asm_starts_with(rhs, "sdiv ") == 1) { mir2asm_emit_binop(b, dest, rhs, "sdiv", "idiv"); return }
    if (mir2asm_starts_with(rhs, "srem ") == 1) { mir2asm_emit_binop(b, dest, rhs, "srem", "idiv"); return }
    if (mir2asm_starts_with(rhs, "and ") == 1) { mir2asm_emit_binop(b, dest, rhs, "and", "and"); return }
    if (mir2asm_starts_with(rhs, "or ") == 1) { mir2asm_emit_binop(b, dest, rhs, "or", "or"); return }
    if (mir2asm_starts_with(rhs, "xor ") == 1) { mir2asm_emit_binop(b, dest, rhs, "xor", "xor"); return }
    if (mir2asm_starts_with(rhs, "shl ") == 1) { mir2asm_emit_binop(b, dest, rhs, "shl", "shl"); return }
    if (mir2asm_starts_with(rhs, "ashr ") == 1) { mir2asm_emit_binop(b, dest, rhs, "ashr", "sar"); return }
    if (mir2asm_starts_with(rhs, "neg ") == 1) { mir2asm_emit_unary(b, dest, rhs, "neg", "neg"); return }
    if (mir2asm_starts_with(rhs, "icmp ") == 1) { mir2asm_emit_icmp(b, dest, rhs); return }
    if (mir2asm_starts_with(rhs, "zext ") == 1 or mir2asm_starts_with(rhs, "trunc ") == 1) { mir2asm_emit_cast(b, dest, rhs); return }
    if (mir2asm_starts_with(rhs, "gep ") == 1) { mir2asm_emit_gep(b, dest, rhs); return }
    if (mir2asm_starts_with(rhs, "call ") == 1) { mir2asm_emit_call(b, dest, rhs); return }
    if (mir2asm_starts_with(rhs, "const ptr \"") == 1)
    {
        let q1 = mir2asm_find(rhs, '"', 0)
        let q2 = mir2asm_find(rhs, '"', q1 + 1)
        let text = if (q1 >= 0 and q2 > q1) { mir2asm_slice(rhs, q1 + 1, q2) } else { "" }
        let label = mir2asm_string_label(b, text)
        mir2asm_line(b, "    lea rax, [" + label + "]")
        mir2asm_line(b, "    mov " + mir2asm_mem(mir2asm_alloc_slot_typed(b, dest, 0, "string")) + ", rax")
        return
    }
    if (mir2asm_starts_with(rhs, "const ") == 1)
    {
        let sp = mir2asm_find(rhs, ' ', 6)
        let ty = if (sp >= 0) { mir2asm_trim(mir2asm_slice(rhs, 6, sp)) } else { "i32" }
        let val = if (sp >= 0) { mir2asm_trim(mir2asm_after(rhs, sp + 1)) } else { "0" }
        mir2asm_line(b, "    mov " + mir2asm_acc(ty) + ", " + mir2asm_operand_typed(b, val, ty))
        mir2asm_line(b, "    mov " + mir2asm_mem(mir2asm_alloc_slot_typed(b, dest, 0, ty)) + ", " + mir2asm_acc(ty))
        return
    }
    mir2asm_line(b, "    mov dword " + mir2asm_mem(mir2asm_alloc_slot(b, dest, 0)) + ", 0")
}
