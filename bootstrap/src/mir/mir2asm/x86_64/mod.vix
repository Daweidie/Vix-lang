#[no_main]
import "abi.vix"
import "instructions.vix"
import "codegen.vix"

pub fn mir2asm_x86_64(mir: string): string
{
    let mut b = mir2asm_new()
    let mut start = 0
    let mut in_string = 0
    for (i in 0 .. mir.length)
    {
        if (mir[i] == '"') { in_string = if (in_string == 0) { 1 } else { 0 } }
        if (mir[i] == '\n' and in_string == 0)
        {
            mir2asm_emit_instruction(&b, mir2asm_trim(mir2asm_slice(mir, start, i)))
            start = i + 1
        }
    }
    if (start < mir.length) { mir2asm_emit_instruction(&b, mir2asm_trim(mir2asm_after(mir, start))) }
    if (b.in_fn == 1) { mir2asm_end_function(&b) }
    if (b.data != "") { return b.out + "section .data\n" + b.data }
    return b.out
}
