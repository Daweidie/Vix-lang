pub fn Formatter_write_uint(self: &mut Formatter, val: u64) { ... }
pub fn Formatter_write_float(self: &mut Formatter, val: f64) { ... }
pub fn Formatter_write_bool(self: &mut Formatter, val: i1) { ... }

pub fn format(fmt_str: string, args: ...): String { ... }
pub fn print_fmt(fmt_str: string, args: ...) { ... }
pub fn eprint_fmt(fmt_str: string, args: ...) { ... }

// Macro-like convenience (design note: uses compile-time expansion)
// The compiler recognizes format!() and expands to type-checked calls:
//   let msg = format!("{} + {} = {}", a, b, a + b)


// ── std/iter.vix ─────────────────────────────────────────────

// Iterator protocol

pub type Range = struct {
    start: i64,
    end: i64,
    step: i64
}

pub fn Range_new(start: i64, end: i64): Range {
    return Range{ start: start, end: end, step: 1 }
}

pub fn Range_step(start: i64, end: i64, step: i64): Range {
    return Range{ start: start, end: end, step: step }
}

pub fn Range_next(self: &mut Range): ?i64 {
    if (self.start >= self.end) {
        return None
    }
    let val = self.start
    self.start = self.start + self.step
    return Some(val)
}

// Map adaptor
pub type MapIter:[T, U] = struct {
    inner: ptr,      // erased iterator
    f: fn(T): U,
    next_fn: fn(ptr): ?U
}

pub fn map:[T, U](iter: &Iter:[T], f: fn(T): U): MapIter:[T, U] { ... }

// Filter adaptor
pub type FilterIter:[T] = struct {
    inner: ptr,
    pred: fn(&T): i1,
    next_fn: fn(ptr): ?T
}

pub fn filter:[T](iter: &Iter:[T], pred: fn(&T): i1): FilterIter:[T] { ... }

// Collect into container
pub fn collect:[T, Container](iter: &mut Iter:[T]): Container { ... }


// ═══════════════════════════════════════════════════════════════
//  PART 3: USAGE EXAMPLES
// ═══════════════════════════════════════════════════════════════

// Example 1: File reading with error handling
fn example_read_config(): Result:[String, Error] {
    let file = File_open("config.json")
    match file {
        Ok(f) -> {
            let content = f.read_to_string()
            return content
        }
        Err(e) -> return Err(e)
    }
}

// Example 2: Vector operations
fn example_vector_ops(): i32 {
    let mut nums: Vec:[i32] = Vec_new()
    nums.push(1)
    nums.push(2)
    nums.push(3)
    nums.push(4)
    nums.push(5)

    // Sum of squares: {1,2,3,4,5} → 1+4+9+16+25 = 55
    let mut sum_sq = 0
    for (i in 0 .. nums.len()) {
        match nums.get(i) {
            Some(x) -> sum_sq = sum_sq + x * x
            None -> {}
        }
    }
    return sum_sq
}

// Example 3: HashMap usage
fn example_hashmap(): void {
    let mut freq: HashMap:[string, i32] = HashMap_new()
    freq.insert("apple", 3)
    freq.insert("banana", 5)
    freq.insert("cherry", 2)

    match freq.get("banana") {
        Some(count) -> println("bananas: " + count.to_string())
        None -> println("no bananas")
    }
}

// Example 4: High-performance bit operations via asm
fn example_asm_bitops(val: u64): u32 {
    let bits = popcount(val)
    let lz = count_leading_zeros(val)
    return bits + lz
}

// Example 5: String manipulation
fn example_string_ops(): String {
    let mut s = String_from("  hello, vix world!  ")
    let trimmed = s.trim()
    let upper = trimmed.to_upper()
    let parts = upper.split(" ")
    return String_join(&parts, "-")
    // Returns: "HELLO,-VIX-WORLD!"
}

// Example 6: Math with sqrt and constants
fn example_math(x: f64, y: f64): f64 {
    let hypot = sqrt(x * x + y * y)
    let angle = atan2(y, x) * 180.0 / PI
    return hypot * cos(angle * PI / 180.0)
}

// Example 7: Inline assembly for SIMD
fn example_asm_simd(a: &[f32], b: &[f32], out: &mut [f32], n: usize) {
    // Add two float arrays using SSE
    let mut i: usize = 0
    while (i + 4 <= n) {
        asm void {
            template:
                "movups xmm0, [{a} + {off}]"
                "movups xmm1, [{b} + {off}]"
                "addps  xmm0, xmm1"
                "movups [{out} + {off}], xmm0"
            inputs:
                a: ptr = a.as_ptr(),
                b: ptr = b.as_ptr(),
                out: ptr = out.as_ptr(),
                off: usize = i * 4
            clobbers: "xmm0", "xmm1", "memory"
        }
        i = i + 4
    }
    // Scalar remainder
    while (i < n) {
        out[i] = a[i] + b[i]
        i = i + 1
    }
}

// Example 8: Atomic operations via asm
pub fn atomic_add(ptr: &mut i32, val: i32): i32 {
    return asm i32 {
        template: "lock xadd [{ptr}], {val}",
        inputs:
            ptr: "r"(ptr) = ptr,
            val: "r"(i32) = val
        output: "=a"(i32) out
        clobbers: "memory"
    }
}

pub fn atomic_cmpxchg(ptr: &mut i32, expected: i32, desired: i32): i32 {
    return asm i32 {
        template:
            "mov eax, {exp}"
            "lock cmpxchg [{ptr}], {des}"
        inputs:
            ptr: "r"(ptr) = ptr,
            exp: "r"(i32) = expected,
            des: "r"(i32) = desired
        output: "=a"(i32) out
        clobbers: "memory"
    }
}

// Example 9: Memory management
fn example_memory(): Result:[void, Error] {
    let buf = Buf_alloc(4096)
    match buf {
        Ok(b) -> {
            zero_mem(b.data, b.size)
            // ... use buffer ...
            free(b.data)
            return Ok(void)
        }
        Err(e) -> return Err(e)
    }
}

// Example 10: Using format! macro
fn example_format(name: string, age: i32): void {
    let msg = format!("Hello, {}! You are {} years old.", name, age)
    println(msg)
}


// ═══════════════════════════════════════════════════════════════
//  SUMMARY: Standard Library API Surface
// ═══════════════════════════════════════════════════════════════
//
//  Module      | Key types              | Key functions
//  ────────────┼────────────────────────┼─────────────────────────────
//  prelude     | Option[T], Result[T,E] | Some, None, Ok, Err
//  io          | File, Stdout, Stderr   | File_open, read/write/close
//  string      | String                 | new, push, split, trim, fmt
//  vec         | Vec[T]                 | new, push/pop, get, sort, map
//  map         | HashMap[K,V]           | insert, get, remove, contains
//  math        | —                      | sin/cos/sqrt, min/max/clamp
//  mem         | Buf                    | malloc/free, copy, zero, swap
//  os          | —                      | args, env, exit, time
//  fmt         | Formatter              | format!, print_fmt
//  iter        | Range, MapIter, etc.   | map, filter, collect
//  asm         | —                      | inline assembly intrinsics
//
// ═══════════════════════════════════════════════════════════════
//  SUMMARY: Inline Assembly Syntax
// ═══════════════════════════════════════════════════════════════
//
//  Form          | Syntax
//  ──────────────┼───────────────────────────────────────────────────
//  Minimal       | asm <type> """<template>"""
//  Short         | asm <type>(<template>, <arg0>, <arg1>, ...)
//  Full          | asm <type> { template: ... inputs: ... output: ...
//                |             clobbers: ... volatile: bool ... }
//  Multi-arch    | asm <type> { x86_64: "...", aarch64: "...", ... }
//  Constraints   | "r", "a", "b", "c", "d", "m", "i", "=&r", ...
//  Clobbers      | Register names, "cc" (flags), "memory"
//
//  Design principles:
//    1. Type-safe: asm always has an explicit return type
//    2. Explicit: inputs, outputs, clobbers must be declared
//    3. Multi-arch: conditional compilation by target
//    4. Familiar: constraint syntax mirrors GCC inline asm
//    5. Vix-native: block syntax matches match/if/while style
// ═══════════════════════════════════════════════════════════════
