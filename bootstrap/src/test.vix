// ── std/io.vix ───────────────────────────────────────────────

// File I/O, standard streams, formatted printing

pub type File = struct {
    handle: ptr,
    closed: i1
}

pub type SeekFrom = Start(i64) | Current(i64) | End(i64)

pub type Stdout = struct {}
pub type Stderr = struct {}

// Global standard stream handles
pub global stdout: Stdout
pub global stderr: Stderr

// Core output
pub fn print(s: string) { ... }
pub fn println(s: string) { ... }
pub fn eprint(s: string) { ... }
pub fn eprintln(s: string) { ... }

// File operations
pub fn File_open(path: string): Result:[File, Error] { ... }
pub fn File_read(self: &File, buf: &mut [u8]): Result:[usize, Error] { ... }
pub fn File_write(self: &File, data: &[u8]): Result:[usize, Error] { ... }
pub fn File_read_to_string(self: &File): Result:[string, Error] { ... }
pub fn File_write_string(self: &File, s: string): Result:[usize, Error] { ... }
pub fn File_seek(self: &File, pos: SeekFrom): Result:[u64, Error] { ... }
pub fn File_size(self: &File): Result:[u64, Error] { ... }
pub fn File_close(mut self: File): Result:[void, Error] { ... }
pub fn File_read_all(path: string): Result:[string, Error] { ... }
pub fn File_write_all(path: string, data: &[u8]): Result:[void, Error] { ... }

// Stdin
pub fn stdin_read_line(): Result:[string, Error] { ... }
pub fn stdin_read_all(): Result:[string, Error] { ... }

impl File {
    // fn drop(self: &mut Self) — auto-close on drop
    fn drop(self: &mut File) {
        if (not self.closed) {
            File_close(self)
        }
    }
}

// Usage example:
fn io_example() {
    let file = File_open("test.txt")
    match file {
        Ok(f) -> {
            let content = f.read_to_string()
            match content {
                Ok(s) -> println(s),
                Err(e) -> eprintln("read error")
            }
        }
        Err(_) -> eprintln("open error")
    }
}


// ── std/string.vix ───────────────────────────────────────────

pub type String = struct {
    data: ptr,
    len: usize,
    cap: usize
}

// Constructors
pub fn String_new(): String { ... }
pub fn String_from(s: string): String { ... }
pub fn String_from_utf8(bytes: &[u8]): Result:[String, Error] { ... }
pub fn String_with_capacity(cap: usize): String { ... }

// Properties
pub fn String_len(self: &String): usize { ... }
pub fn String_is_empty(self: &String): i1 { ... }
pub fn String_capacity(self: &String): usize { ... }

// Mutation
pub fn String_push(self: &mut String, ch: char) { ... }
pub fn String_push_str(self: &mut String, s: string) { ... }
pub fn String_pop(self: &mut String): ?char { ... }
pub fn String_clear(self: &mut String) { ... }
pub fn String_insert(self: &mut String, idx: usize, ch: char) { ... }
pub fn String_remove(self: &mut String, idx: usize): char { ... }
pub fn String_reserve(self: &mut String, additional: usize) { ... }
pub fn String_shrink(self: &mut String) { ... }

// Slicing
pub fn String_slice(self: &String, start: usize, end: usize): &str { ... }
pub fn String_as_bytes(self: &String): &[u8] { ... }
pub fn String_as_ptr(self: &String): ptr { ... }

// Search & compare
pub fn String_contains(self: &String, needle: string): i1 { ... }
pub fn String_starts_with(self: &String, prefix: string): i1 { ... }
pub fn String_ends_with(self: &String, suffix: string): i1 { ... }
pub fn String_find(self: &String, needle: string): ?usize { ... }
pub fn String_rfind(self: &String, needle: string): ?usize { ... }
pub fn String_eq(self: &String, other: &String): i1 { ... }

// Split & join
pub fn String_split(self: &String, delim: string): Vec:[String] { ... }
pub fn String_lines(self: &String): Vec:[String] { ... }
pub fn String_trim(self: &String): String { ... }
pub fn String_trim_start(self: &String): String { ... }
pub fn String_trim_end(self: &String): String { ... }
pub fn String_replace(self: &String, from: string, to: string): String { ... }
pub fn String_join(strings: &[String], sep: string): String { ... }

// Case conversion
pub fn String_to_lower(self: &String): String { ... }
pub fn String_to_upper(self: &String): String { ... }

// Numeric conversion
pub fn String_parse_i32(self: &String): Result:[i32, Error] { ... }
pub fn String_parse_i64(self: &String): Result:[i64, Error] { ... }
pub fn String_parse_f64(self: &String): Result:[f64, Error] { ... }

impl String {
    fn drop(self: &mut String) {
        if (self.data != null) {
            free(self.data)
        }
    }
}


// ── std/vec.vix ──────────────────────────────────────────────

// Growable array with generics

pub type Vec:[T] = struct {
    data: ptr,
    len: usize,
    cap: usize
}

pub fn Vec_new:[T](): Vec:[T] { ... }
pub fn Vec_with_capacity:[T](cap: usize): Vec:[T] { ... }
pub fn Vec_from_slice:[T](slice: &[T]): Vec:[T] { ... }

// Size
pub fn Vec_len:[T](self: &Vec:[T]): usize { ... }
pub fn Vec_is_empty:[T](self: &Vec:[T]): i1 { ... }
pub fn Vec_capacity:[T](self: &Vec:[T]): usize { ... }

// Element access
pub fn Vec_get:[T](self: &Vec:[T], idx: usize): ?T { ... }
pub fn Vec_get_mut:[T](self: &mut Vec:[T], idx: usize): ?&mut T { ... }
pub fn Vec_first:[T](self: &Vec:[T]): ?T { ... }
pub fn Vec_last:[T](self: &Vec:[T]): ?T { ... }

// Mutation
pub fn Vec_push:[T](self: &mut Vec:[T], val: T) { ... }
pub fn Vec_pop:[T](self: &mut Vec:[T]): ?T { ... }
pub fn Vec_insert:[T](self: &mut Vec:[T], idx: usize, val: T) { ... }
pub fn Vec_remove:[T](self: &mut Vec:[T], idx: usize): T { ... }
pub fn Vec_clear:[T](self: &mut Vec:[T]) { ... }
pub fn Vec_resize:[T](self: &mut Vec:[T], new_len: usize, fill: T) { ... }
pub fn Vec_reserve:[T](self: &mut Vec:[T], additional: usize) { ... }
pub fn Vec_shrink:[T](self: &mut Vec:[T]) { ... }
pub fn Vec_extend:[T](self: &mut Vec:[T], other: &Vec:[T]) { ... }
pub fn Vec_truncate:[T](self: &mut Vec:[T], len: usize) { ... }

// Search & sort
pub fn Vec_contains:[T](self: &Vec:[T], val: &T): i1 { ... }
pub fn Vec_sort:[T](self: &mut Vec:[T]) { ... }
pub fn Vec_sort_by:[T](self: &mut Vec:[T], cmp: fn(&T, &T): i32) { ... }
pub fn Vec_binary_search:[T](self: &Vec:[T], val: &T): Result:[usize, usize] { ... }
pub fn Vec_reverse:[T](self: &mut Vec:[T]) { ... }

// Transform
pub fn Vec_map:[T, U](self: &Vec:[T], f: fn(&T): U): Vec:[U] { ... }
pub fn Vec_filter:[T](self: &Vec:[T], pred: fn(&T): i1): Vec:[T] { ... }
pub fn Vec_fold:[T, Acc](self: &Vec:[T], init: Acc, f: fn(Acc, &T): Acc): Acc { ... }

// Conversion
pub fn Vec_as_slice:[T](self: &Vec:[T]): &[T] { ... }
pub fn Vec_as_mut_slice:[T](self: &mut Vec:[T]): &mut [T] { ... }

impl Vec:[T] {
    fn drop(self: &mut Vec:[T]) {
        if (self.data != null) {
            free(self.data)
        }
    }
}

// Usage example
fn vec_example(): i32 {
    let mut v: Vec:[i32] = Vec_new:[i32]()
    v.push(10)
    v.push(20)
    v.push(30)

    let mut sum = 0
    for (i in 0 .. v.len()) {
        match v.get(i) {
            Some(x) -> sum = sum + x
            None -> {}
        }
    }
    return sum
}


// ── std/map.vix ──────────────────────────────────────────────

// Hash map with open addressing, Robin-Hood hashing

pub type HashMap:[K, V] = struct {
    entries: ptr,
    len: usize,
    cap: usize
}

pub fn HashMap_new:[K, V](): HashMap:[K, V] { ... }
pub fn HashMap_with_capacity:[K, V](cap: usize): HashMap:[K, V] { ... }

pub fn HashMap_insert:[K, V](self: &mut HashMap:[K, V], key: K, val: V): ?V { ... }
pub fn HashMap_get:[K, V](self: &HashMap:[K, V], key: &K): ?V { ... }
pub fn HashMap_get_mut:[K, V](self: &mut HashMap:[K, V], key: &K): ?&mut V { ... }
pub fn HashMap_remove:[K, V](self: &mut HashMap:[K, V], key: &K): ?V { ... }
pub fn HashMap_contains:[K, V](self: &HashMap:[K, V], key: &K): i1 { ... }
pub fn HashMap_len:[K, V](self: &HashMap:[K, V]): usize { ... }
pub fn HashMap_is_empty:[K, V](self: &HashMap:[K, V]): i1 { ... }
pub fn HashMap_clear:[K, V](self: &mut HashMap:[K, V]) { ... }
pub fn HashMap_keys:[K, V](self: &HashMap:[K, V]): Vec:[K] { ... }
pub fn HashMap_values:[K, V](self: &HashMap:[K, V]): Vec:[V] { ... }

// Usage example
fn map_example(): i32 {
    let mut scores: HashMap:[string, i32] = HashMap_new()
    scores.insert("alice", 100)
    scores.insert("bob", 85)

    match scores.get("alice") {
        Some(score) -> return score
        None -> return -1
    }
}


// ── std/math.vix ─────────────────────────────────────────────

extern "C" {
    fn sin(x: f64): f64
    fn cos(x: f64): f64
    fn tan(x: f64): f64
    fn asin(x: f64): f64
    fn acos(x: f64): f64
    fn atan(x: f64): f64
    fn atan2(y: f64, x: f64): f64
    fn sqrt(x: f64): f64
    fn cbrt(x: f64): f64
    fn pow(base: f64, exp: f64): f64
    fn exp(x: f64): f64
    fn ln(x: f64): f64
    fn log10(x: f64): f64
    fn log2(x: f64): f64
    fn floor(x: f64): f64
    fn ceil(x: f64): f64
    fn round(x: f64): f64
    fn fabs(x: f64): f64
    fn fmod(x: f64, y: f64): f64
}

// Constants
pub global PI: f64 = 3.14159265358979323846
pub global E: f64 = 2.71828182845904523536
pub global TAU: f64 = 6.28318530717958647692

// Generic min/max/clamp (requires trait bounds in practice)
pub fn min:[T](a: T, b: T): T { if (a < b) { return a } return b }
pub fn max:[T](a: T, b: T): T { if (a > b) { return a } return b }
pub fn clamp:[T](val: T, lo: T, hi: T): T {
    if (val < lo) { return lo }
    if (val > hi) { return hi }
    return val
}
pub fn abs:[T](val: T): T { if (val < 0) { return -val } return val }

// Linear interpolation
pub fn lerp(a: f64, b: f64, t: f64): f64 { return a + (b - a) * t }

// Power of two utilities (uses asm on supported archs)
pub fn is_power_of_two(x: usize): i1 { return x != 0 and (x & (x - 1)) == 0 }
pub fn next_power_of_two(x: usize): usize {
    let mut v = x - 1
    v = v | (v >> 1)
    v = v | (v >> 2)
    v = v | (v >> 4)
    v = v | (v >> 8)
    v = v | (v >> 16)
    v = v | (v >> 32)
    return v + 1
}

// Fast bit operations via inline assembly
pub fn popcount(x: u64): u32 {
    return asm u32 {
        template: "popcnt {out}, {x}",
        inputs: x: "r"(u64) = x,
        output: "=r"(u32) out
    }
}

pub fn count_leading_zeros(x: u64): u32 {
    return asm u32 {
        template: "lzcnt {out}, {x}",
        inputs: x: "r"(u64) = x,
        output: "=r"(u32) out
    }
}


// ── std/mem.vix ──────────────────────────────────────────────

extern "C" {
    fn malloc(size: usize): ptr
    fn calloc(nmemb: usize, size: usize): ptr
    fn realloc(ptr: ptr, size: usize): ptr
    fn free(ptr: ptr)
    fn memcpy(dest: ptr, src: ptr, n: usize): ptr
    fn memmove(dest: ptr, src: ptr, n: usize): ptr
    fn memset(s: ptr, c: i32, n: usize): ptr
    fn memcmp(s1: ptr, s2: ptr, n: usize): i32
}

// Typed wrappers
pub fn alloc:[T](): ptr { return malloc(size_of(T)) }
pub fn alloc_array:[T](count: usize): ptr { return calloc(count, size_of(T)) }
pub fn zero_mem(ptr: ptr, size: usize) { memset(ptr, 0, size) }
pub fn copy_mem:[T](dest: &mut T, src: &T, count: usize) { memcpy(dest, src, count * size_of(T)) }
pub fn swap:[T](a: &mut T, b: &mut T) {
    let tmp: T = @a
    @a = @b
    @b = tmp
}

// Sized memory block
pub type Buf = struct {
    data: ptr,
    size: usize
}

pub fn Buf_alloc(size: usize): Result:[Buf, Error] {
    let data = malloc(size)
    if (data == null) {
        return Err(Error{ code: 1, message: "oom" })
    }
    return Ok(Buf{ data: data, size: size })
}


// ── std/os.vix ───────────────────────────────────────────────

extern "C" {
    fn getenv(name: ptr): ptr
    fn system(cmd: ptr): i32
    fn clock(): i64  // CLOCKS_PER_SEC ticks
}

pub fn exit(code: i32): void {
    // noreturn
    asm void {
        template: "mov edi, {c}\nmov eax, 60\nsyscall",
        x86_64: "mov edi, {c}\nmov eax, 60\nsyscall",
        aarch64: "mov x0, {c}\nmov x8, #93\nsvc #0",
        inputs: c: "r"(i32) = code
    }
}

pub fn args(): Vec:[string] { ... }
pub fn env_var(name: string): ?string { ... }
pub fn set_env_var(name: string, val: string) { ... }
pub fn current_dir(): string { ... }
pub fn change_dir(path: string): Result:[void, Error] { ... }
pub fn cpu_count(): usize { ... }
pub fn page_size(): usize { ... }

// High-resolution time
pub fn time_nanos(): u64 {
    return asm u64 {
        x86_64: "rdtsc\nshl rdx, 32\nor rax, rdx",
        output: "=a"(u64) out
    }
}

// Platform detection (comptime)
// pub comptime OS: string = "linux" | "macos" | "windows"
// pub comptime ARCH: string = "x86_64" | "aarch64" | "riscv64"


