// ── std/prelude.vix ─────────────────────────────────────────

// Core types available without explicit import

pub type Option:[T] = Some(T) | None
pub type Result:[T, E] = Ok(T) | Err(E)

// Error type
pub type Error = struct {
    code: i32,
    message: string
}

// Drop trait (for RAII cleanup)
// trait syntax — future language feature, shown as design
