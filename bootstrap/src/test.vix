// ═══════════════════════════════════════════════════════════════
//  Vix Standard Library Design & Inline Assembly Syntax
// ═══════════════════════════════════════════════════════════════
//
//  std/ organization:
//    std/
//    ├─ prelude.vix   — Option, Result, core traits (auto-imported)
//    ├─ io.vix        — print, println, File, stdin/stdout
//    ├─ string.vix    — String type, utf-8 ops, format
//    ├─ vec.vix       — Vec[T] growable array
//    ├─ map.vix       — HashMap[K, V]
//    ├─ math.vix      — sin/cos/sqrt, min/max/clamp, rand
//    ├─ mem.vix       — alloc, free, copy, cmp, zero
//    ├─ os.vix        — args, env, exit, clock
//    ├─ fmt.vix       — printf-style formatting with type safety
//    ├─ iter.vix      — Iterator trait, range, map/filter adaptors
//    └─ asm.vix       — inline assembly definitions (arch bindings)
// ═══════════════════════════════════════════════════════════════


// ═══════════════════════════════════════════════════════════════
//  PART 1: INLINE ASSEMBLY SYNTAX
// ═══════════════════════════════════════════════════════════════
//
//  Inline assembly is a first-class language construct introduced
//  with the `asm` keyword. It produces a typed value and integrates
//  with the compiler's register allocator.
//
//  Three forms are supported:
//
//  A. Minimal form  —  asm <ret_type> """<template>"""
//  B. Short form    —  asm <ret_type>(<template>, <inputs...>)
//  C. Full form     —  asm block with explicit operands & clobbers
//
//  Architecture can be specified with a tag:
//    asm x86_64 i32 { ... }
//    asm aarch64 void { ... }


// --- A. Minimal inline assembly ----------------------------------

fn asm_minimal_example(): i32 {
    // Single instruction, returns eax (implicit on x86_64)
    let cpuid_eax: i32 = asm i32 """
        cpuid
    """

    // Return register value directly
    let timestamp: i64 = asm i64 """
        rdtsc
    """

    return cpuid_eax
}


// --- B. Short form: positional operands --------------------------

fn asm_short_form_example(a: i32, b: i32): i32 {
    // $0, $1, ... map to function arguments positionally
    let result: i32 = asm i32(
        "add $0, $1",
        a, b
    )

    // Multiple instructions separated by \n
    let product: i32 = asm i32(
        "mov eax, $0\nmul $1",
        a, b
    )

    return result
}


// --- C. Full form: explicit operands & clobbers -------------------

fn asm_full_form_example(ptr: ptr, n: i32): i32 {
    // Named template placeholders {name}
    // Explicit input/output bindings
    // Registered clobbers for correct codegen
    let result: i32 = asm i32 {
        template:
            "mov esi, {src}"
            "mov ecx, {count}"
            "xor eax, eax"
            "1: add eax, [esi]"
            "add esi, 4"
            "loop 1b"
        inputs:
            src: ptr = ptr,
            count: i32 = n
        output: eax
        clobbers: "esi", "ecx", "cc"
    }

    return result
}

fn asm_volatile_example(): void {
    // volatile — not optimized away; alignstack — ensure stack alignment
    asm void {
        template: "int 0x80"
        volatile: true
        alignstack: true
        clobbers: "memory"
    }
}

fn asm_multiarch_example(val: i32): i32 {
    // Compiler selects template based on target arch
    let result: i32 = asm i32 {
        x86_64: "mov eax, {v}\nadd eax, 42",
        aarch64: "add w0, {v}, #42",
        riscv64: "addi a0, {v}, 42",
        inputs:
            v: i32 = val
        output: return_register
    }

    return result
}


// --- D. Extended operand constraints (GCC/LLVM style) -------------
//
//  Operand constraints tell the compiler what register class to use:
//    "r"   — any general-purpose register
//    "a"   — eax/rax (x86_64)
//    "b"   — ebx/rbx
//    "c"   — ecx/rcx
//    "d"   — edx/rdx
//    "m"   — memory operand
//    "i"   — immediate operand
//    "=&r" — early-clobber output

fn asm_constraints_example(a: i32, b: i32): i32 {
    let out: i32 = asm i32 {
        template: "imul {b}, {a}",
        inputs:
            a: "r"(i32) = a,
            b: "r"(i32) = b
        output: "=a"(i32) out
        clobbers: "cc"
    }

    return out
}


