import "lexer.vix"
import "parser.vix"
import "ast.vix"
import "typeck.vix"
import "semantic.vix"
import "desugar.vix"
import "codegen.vix"
import "error.vix"

extern "C"
{
    fn fopen(filename: ptr, mode: ptr): ptr
    fn fclose(file: ptr): i32
    fn fread(buf: ptr, size: i64, count: i64, file: ptr): i64
    fn fputs(s: string, file: ptr): i32
    fn fseek(file: ptr, offset: i64, whence: i32): i32
    fn ftell(file: ptr): i64
    fn system(command: ptr): i32
    fn vix_print_stderr(s: string)
    fn malloc(size: usize): string
    fn vix_diag_red(): string
    fn vix_diag_yellow(): string
    fn vix_diag_reset(): string
    fn vix_compiler_runtime_object_path(argv0: string): string
}

fn string_ends_with(text: string, suffix: string): i32
{
    if (text.length < suffix.length) { return 0 }
    let offset = text.length - suffix.length
    for (i in 0 .. suffix.length)
    {
        if (text[offset + i] != suffix[i]) { return 0 }
    }
    return 1
}

fn compiler_mode(arg: string): ?string
{
    if (arg == "-h" or arg == "--help") { return Some("--help") }
    if (arg == "-v" or arg == "--version") { return Some("--version") }
    if (arg == "--lex" or arg == "--parse-stats" or arg == "--parser" or arg == "--ast" or arg == "-ast" or arg == "--typeinfer" or arg == "--tyinfer" or arg == "--semantic" or arg == "--check" or arg == "-ll" or arg == "-obj" or arg == "-exe") { return Some(arg) }
    return None
}

fn strip_vix_ext(name: string): string
{
    if (string_ends_with(name, ".vix") == 1)
    {
        let mut out = ""
        let end = name.length - 4
        for (i in 0 .. end)
        {
            out = out + char_string(name[i])
        }
        return out
    }
    return name
}

fn find_last_char(text: string, needle: i8): i32
{
    let mut found = -1
    for (i in 0 .. text.length)
    {
        if (text[i] == needle) { found = i }
    }
    return found
}

fn slice_string(text: string, start: i32, end: i32): string
{
    let mut out = ""
    for (i in start .. end)
    {
        out = out + char_string(text[i])
    }
    return out
}

fn dirname(path: string): string
{
    let slash = find_last_char(path, '/')
    if (slash < 0) { return "." }
    if (slash == 0) { return "/" }
    return slice_string(path, 0, slash)
}

fn runtime_object_path(compiler_path: string): string
{
    return vix_compiler_runtime_object_path(compiler_path)
}

fn shell_command(command: string): i32
{
    return system(command)
}

fn diag_print(text: string)
{
    vix_print_stderr(text)
}

fn info_print(text: string)
{
    print(text)
}

fn ir_output_path(filename: string, output: string): string
{
    if (output != "") { return output }
    return strip_vix_ext(filename) + ".ll"
}

fn artifact_output_path(filename: string, output: string, emit: string): string
{
    if (output != "") { return output }
    let base = strip_vix_ext(filename)
    if (emit == "exe" or emit == "-exe") { return base }
    return base + ".o"
}

fn print_help(): i32
{
    print("OVERVIEW: Vix Compiler LLVM Bootstrap")
    print("")
    print("USAGE: vixc0 [options] <input.vix>")
    print("")
    print("OPTIONS:")
    print("  -o <file>              Write output to <file>")
    print("  -ll [file]             Emit LLVM IR to <file> (default: <input>.ll)")
    print("  -obj                   Emit object file (default: <input>.o)")
    print("  -exe                   Emit executable (default: <input>)")
    print("  -l<lib>, -l <lib>      Link executable with a system library")
    print("  -L<dir>, -L <dir>      Add a system library search path")
    print("  --check                Syntax & type check only")
    print("  --lex                  Print tokens to stdout")
    print("  --parse-stats          Print lightweight parser input statistics")
    print("  --parser               Print parse tree to stdout")
    print("  --ast / -ast                 Print AST to stdout")
    print("  --typeinfer            Print type inference result to stdout")
    print("  --semantic             Print semantic analysis to stdout")
    print("  -v, --version          Display compiler version information")
    print("  -h, --help             Display this help message")
    return 0
}

fn print_version(): i32
{
    print("vixc0 0.4.2 (bootstrap)")
    return 0
}

fn source_file_arg(arg: string): ?string
{
    return match string_ends_with(arg, ".vix") {
        1 -> Some(arg)
        _ -> None
    }
}

fn run_mode(mode: string, src: string, filename: string, emit: string, output: string, runtime_object: string, link_args: string): ?i32
{
    match mode
    {
        "--lex" -> {
            info_print(tokenize_debug(src))
            return Some(0)
        }
        "--parse-stats" -> {
            info_print(parse_program_stats(src, filename))
            return Some(0)
        }
        _ -> {}
    }

    let program = parse_program(src, filename)

    match mode
    {
        "--parser" -> {
            if (program.ok == 0)
            {
                info_print(program.error)
            }
            else
            {
                info_print(ast_program_debug(program))
            }
            return Some(0)
        }
        "--ast" | "-ast" -> {
            if (program.ok == 0)
            {
                info_print(program.error)
            }
            else
            {
                info_print(ast(program))
            }
            return Some(0)
        }
        _ -> {}
    }
    
    if (program.ok == 0)
    {
        diag_print(program.error)
        return Some(1)
    }

    let lowered_program = desugar_program(program)

    let semantic_result = semantic_check_program(lowered_program, src, filename)
    match mode
    {
        "--semantic" -> {
            info_print(semantic_result_debug(semantic_result))
            return Some(0)
        }
        _ -> {}
    }

    if (semantic_result.error_count > 0)
    {
        match mode
        {
            "--typeinfer" | "--tyinfer" -> {
                info_print(semantic_result_debug(semantic_result))
                if (semantic_result.error_count == semantic_result.type_error_count)
                {
                    return Some(0)
                }
                return Some(1)
            }
            _ -> {}
        }
        diag_print(semantic_result_debug(semantic_result))
        return Some(1)
    }
    if (semantic_result.warning_count > 0)
    {
        diag_print(semantic_result_debug(semantic_result))
    }

    let infer_result = typeck_check_program(lowered_program)
    match mode
    {
        "--typeinfer" | "--tyinfer" -> {
            info_print(typeck_result_debug(infer_result, src, filename))
            return Some(0)
        }
        _ -> {}
    }

    if (infer_result.ok == 0)
    {
        diag_print(typeck_result_debug(infer_result, src, filename))
        return Some(1)
    }

    match mode
    {
        "--check" -> { return Some(0) }
        _ -> {}
    }

    let ir = codegen_program(lowered_program)
    if (emit == "stdout")
    {
        print(ir)
        return None
    }
    let mut ir_path = ""
    if (emit == "ir")
    {
        ir_path = ir_output_path(filename, output)
    }
    else
    {
        ir_path = strip_vix_ext(filename) + ".ll"
    }
    write_text_file(ir_path, ir)
    if (emit == "ir")
    {
        print(ir_path)
        return Some(0)
    }

    let artifact_path = artifact_output_path(filename, output, emit)
    let mut command = ""
    if (emit == "-obj")
    {
        command = "clang -c " + ir_path + " -o " + artifact_path
    }
    else
    {
        command = "clang " + ir_path + " " + runtime_object + " -o " + artifact_path + " " + link_args
    }
    if (shell_command(command) != 0)
    {
        diag_print("vixc: error: failed to build '" + artifact_path + "'")
        return Some(1)
    }
    print(artifact_path)
    return Some(0)
}

fn write_text_file(path: string, content: string): i32
{
    let file = fopen(path, "w")
    if (file == 0)
    {
        diag_print("vixc: error: cannot write file '" + path + "'")
        return 1
    }
    fputs(content, file)
    fclose(file)
    return 0
}

fn read_source_file(path: ptr): string
{
    let file = fopen(path, "r")
    if (file == 0)
    {
        return ""
    }
    fseek(file, 0, 2)
    let size = ftell(file)
    fseek(file, 0, 0)
    let buf = malloc(size + 1)
    let n = fread(buf, 1, size, file)
    buf[n] = 0
    fclose(file)
    return buf
}

fn main(argc: i32, argv: ptr): i32
{
    let mut src = ""
    let mut mode = "codegen"
    let mut filename = ""
    let mut want_help = 0
    let mut want_version = 0
    let mut emit = "stdout"
    let mut output = ""
    let mut has_input = 0
    let mut link_args = ""

    let mut i = 1
    while (i < argc)
    {
        let arg = argv[i]
        if (arg == "-h" or arg == "--help")
        {
            want_help = 1
        }
        elif (arg == "-v" or arg == "--version")
        {
            want_version = 1
        }
        elif (arg == "-o")
        {
            if (i + 1 < argc)
            {
                i += 1
                output = argv[i]
            }
            else
            {
                diag_print("vixc: error: '-o' requires an argument")
                return 1
            }
        }
        elif (arg == "-ll")
        {
            emit = "ir"
            if (i + 1 < argc)
            {
                let next = argv[i + 1]
                if (string_ends_with(next, ".vix") == 0 and string_ends_with(next, ".ll") == 1)
                {
                    output = next
                    i += 1
                }
            }
        }
        elif (arg == "-obj")
        {
            emit = "-obj"
        }
        elif (arg == "-exe")
        {
            emit = "-exe"
        }
        elif (arg == "-l" or arg == "-L")
        {
            if (i + 1 < argc)
            {
                i += 1
                link_args = link_args + " " + arg + argv[i]
            }
            else
            {
                diag_print("vixc: error: '" + arg + "' requires an argument")
                return 1
            }
        }
        elif (str_starts_with(arg, "-l") == 1 or str_starts_with(arg, "-L") == 1)
        {
            link_args = link_args + " " + arg
        }
        else
        {
            match compiler_mode(arg)
            {
                Some(next_mode) -> {
                    if (next_mode == "--help") { want_help = 1 }
                    elif (next_mode == "--version") { want_version = 1 }
                    elif (next_mode == "-ll") { emit = "ir" }
                    elif (next_mode == "-obj") { emit = "-obj" }
                    elif (next_mode == "-exe") { emit = "-exe" }
                    else { mode = next_mode }
                }
                None -> match source_file_arg(arg)
                {
                    Some(path) -> {
                        if (has_input == 1)
                        {
                            diag_print("vixc: error: multiple input files not supported")
                            return 1
                        }
                        src = read_source_file(path)
                        filename = path
                        has_input = 1
                    }
                    None -> {
                        diag_print("vixc: error: unrecognized command-line option '" + arg + "'\n")
                        return 1
                    }
                }
            }
        }
        i += 1
    }

    if (want_help == 1) { return print_help() }
    if (want_version == 1) { return print_version() }

    if (has_input == 0)
    {
        diag_print("vixc: fatal error: no input files")
        diag_print("compilation terminated.")
        return 1
    }

    if (src == "")
    {
        diag_print("vixc: error: cannot read file '" + filename + "'")
        return 1
    }

    match run_mode(mode, src, filename, emit, output, runtime_object_path(argv[0]), link_args)
    {
        Some(code) -> return code
        None -> return 0
    }
}
