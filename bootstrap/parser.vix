#[no_main]
import "lexer.vix"
import "ast.vix"
import "error.vix"

pub type Parser = struct {
    stream: TokenStream,
    pos: i32,
    ok: i32,
    error: string,
    expr_store: ExprStore,
    store: StmtStore,
    source: string,
    filename: string
}

pub fn parser_new(src: string, filename: string): Parser
{
    return Parser{ stream: tokenize(src), pos: 0, ok: 1, error: "", expr_store: expr_store_new(), store: stmt_store_new(), source: src, filename: filename }
}

pub fn parser_kind(parser: &Parser): i32
{
    return stream_kind_at(parser.stream, parser.pos)
}

pub fn parser_text(parser: &Parser): string
{
    return stream_text_at(parser.stream, parser.pos)
}

pub fn parser_int(parser: &Parser): i32
{
    return stream_int_at(parser.stream, parser.pos)
}

pub fn parser_line(parser: &Parser): i32
{
    return stream_line_at(parser.stream, parser.pos)
}

pub fn parser_col(parser: &Parser): i32
{
    return stream_col_at(parser.stream, parser.pos)
}

pub fn parser_expr_at(parser: &Parser, idx: i32, line: i32, col: i32): i32
{
    if (idx >= 0)
    {
        expr_store_set_loc(parser.expr_store, idx, line, col)
    }
    return idx
}

pub fn parser_stmt_at(parser: &Parser, idx: i32, line: i32, col: i32): i32
{
    if (idx >= 0)
    {
        stmt_store_set_loc(parser.store, idx, line, col)
    }
    return idx
}

pub fn parser_float(parser: &Parser): f64
{
    return stream_float_at(parser.stream, parser.pos)
}

pub fn parser_at_end(parser: &Parser): i32
{
    if (parser_kind(parser) == tk_eof()) { return 1 }
    return 0
}

pub fn parser_advance(parser: &Parser)
{
    if (parser.pos + 1 < stream_len(parser.stream))
    {
        parser.pos += 1
    }
}

pub fn parser_fail(parser: &Parser, message: string)
{
    if (parser.ok == 1)
    {
        parser.ok = 0
        let mut line = parser_line(parser)
        let mut col = parser_col(parser)
        let text = parser_text(parser)
        let mut length = 1
        if (text != "" and text != ";" and text != "," and text != "{" and text != "}" and text != "(" and text != ")" and text != "[" and text != "]" and text != "=>" and text != "->" and text != ".." and text != "..." and text != "==" and text != "!=" and text != "<=" and text != ">=" and text != "+=" and text != "-=")
        {
            length = text.length
        }
        if (parser_kind(parser) == tk_eof())
        {
            if (parser.pos > 0)
            {
                line = stream_line_at(parser.stream, parser.pos - 1)
                col = stream_col_at(parser.stream, parser.pos - 1)
            }
        }
        parser.error = format_diagnostic(parser.source, parser.filename, 0, "ParseError", message, line, col, length)
    }
}

pub fn parser_accept_text(parser: &Parser, text: string): i32
{
    if (parser_text(parser) == text)
    {
        parser_advance(parser)
        return 1
    }
    return 0
}

pub fn parser_expect_text(parser: &Parser, text: string): i32
{
    if (parser_accept_text(parser, text) == 1)
    {
        return 1
    }
    parser_fail(parser, "expected '" + text + "', got '" + parser_text(parser) + "'")
    return 0
}

pub fn parser_expect_kind(parser: &Parser, kind: i32): i32
{
    if (parser_kind(parser) == kind)
    {
        parser_advance(parser)
        return 1
    }
    parser_fail(parser, "unexpected token '" + parser_text(parser) + "'")
    return 0
}

pub fn parse_expression(parser: &Parser): i32
{
    return parse_logical_or(parser)
}

pub fn parse_logical_or(parser: &Parser): i32
{
    let mut left = parse_logical_and(parser)
    if (parser.ok == 0) { return -1 }
    while (parser_text(parser) == "or")
    {
        let line = parser_line(parser)
        let col = parser_col(parser)
        parser_advance(parser)
        let right = parse_logical_and(parser)
        if (parser.ok == 0) { return -1 }
        left = parser_expr_at(parser, ast_expr_binop(parser.expr_store, "or", left, right), line, col)
    }
    return left
}

pub fn parse_logical_and(parser: &Parser): i32
{
    let mut left = parse_comparison(parser)
    if (parser.ok == 0) { return -1 }
    while (parser_text(parser) == "and")
    {
        let line = parser_line(parser)
        let col = parser_col(parser)
        parser_advance(parser)
        let right = parse_comparison(parser)
        if (parser.ok == 0) { return -1 }
        left = parser_expr_at(parser, ast_expr_binop(parser.expr_store, "and", left, right), line, col)
    }
    return left
}

pub fn parse_comparison(parser: &Parser): i32
{
    let left = parse_additive(parser)
    if (parser.ok == 0) { return -1 }
    if (parser_text(parser) == "==" or parser_text(parser) == "!=" or parser_text(parser) == "<" or parser_text(parser) == "<=" or parser_text(parser) == ">" or parser_text(parser) == ">=")
    {
        let op = parser_text(parser)
        let line = parser_line(parser)
        let col = parser_col(parser)
        parser_advance(parser)
        let right = parse_additive(parser)
        if (parser.ok == 0) { return -1 }
        return parser_expr_at(parser, ast_expr_binop(parser.expr_store, op, left, right), line, col)
    }
    return left
}

pub fn parse_additive(parser: &Parser): i32
{
    let mut left = parse_multiplicative(parser)
    if (parser.ok == 0) { return -1 }
    while (parser_text(parser) == "+" or parser_text(parser) == "-")
    {
        let op = parser_text(parser)
        let line = parser_line(parser)
        let col = parser_col(parser)
        parser_advance(parser)
        let right = parse_multiplicative(parser)
        if (parser.ok == 0) { return -1 }
        left = parser_expr_at(parser, ast_expr_binop(parser.expr_store, op, left, right), line, col)
    }
    return left
}

pub fn parse_multiplicative(parser: &Parser): i32
{
    let mut left = parse_unary(parser)
    if (parser.ok == 0) { return -1 }
    while (parser_text(parser) == "*" or parser_text(parser) == "/" or parser_text(parser) == "%")
    {
        let op = parser_text(parser)
        let line = parser_line(parser)
        let col = parser_col(parser)
        parser_advance(parser)
        let right = parse_unary(parser)
        if (parser.ok == 0) { return -1 }
        left = parser_expr_at(parser, ast_expr_binop(parser.expr_store, op, left, right), line, col)
    }
    return left
}

pub fn parse_unary(parser: &Parser): i32
{
    return match parser_text(parser) {
        "ref" | "&" -> {
            let line = parser_line(parser)
            let col = parser_col(parser)
            parser_advance(parser)
            let name = parser_text(parser)
            if (parser_expect_kind(parser, tk_ident()) == 0) { return -1 }
            parser_expr_at(parser, ast_expr_addr(parser.expr_store, name), line, col)
        }
        "@" -> {
            let line = parser_line(parser)
            let col = parser_col(parser)
            parser_advance(parser)
            let operand = parse_unary(parser)
            if (parser.ok == 0) { return -1 }
            parser_expr_at(parser, ast_expr_deref(parser.expr_store, operand), line, col)
        }
        "-" -> {
            let line = parser_line(parser)
            let col = parser_col(parser)
            parser_advance(parser)
            let operand = parse_unary(parser)
            if (parser.ok == 0) { return -1 }
            parser_expr_at(parser, ast_expr_unaryop(parser.expr_store, "-", operand), line, col)
        }
        "!" -> {
            let line = parser_line(parser)
            let col = parser_col(parser)
            parser_advance(parser)
            let operand = parse_unary(parser)
            if (parser.ok == 0) { return -1 }
            parser_expr_at(parser, ast_expr_unaryop(parser.expr_store, "!", operand), line, col)
        }
        _ -> parse_postfix(parser)
    }
}

pub fn parse_postfix(parser: &Parser): i32
{
    let mut expr = parse_primary(parser)
    if (parser.ok == 0) { return -1 }
    while (parser_text(parser) == "[" or parser_text(parser) == ".")
    {
        if (parser_text(parser) == "[")
        {
            let line = parser_line(parser)
            let col = parser_col(parser)
            parser_advance(parser)
            let index_idx = parse_expression(parser)
            if (parser.ok == 0) { return -1 }
            parser_expect_text(parser, "]")
            if (parser.ok == 0) { return -1 }
            expr = parser_expr_at(parser, ast_expr_index(parser.expr_store, expr, index_idx), line, col)
        }
        else
        {
            let line = parser_line(parser)
            let col = parser_col(parser)
            parser_advance(parser)
            let field_name = parser_text(parser)
            if (parser_expect_kind(parser, tk_ident()) == 0) { return -1 }
            expr = parser_expr_at(parser, ast_expr_field(parser.expr_store, expr, field_name), line, col)
        }
    }
    return expr
}

pub fn parse_primary(parser: &Parser): i32
{
    let kind = parser_kind(parser)
    if (kind == tk_number())
    {
        let line = parser_line(parser)
        let col = parser_col(parser)
        let val = parser_int(parser)
        parser_advance(parser)
        return parser_expr_at(parser, ast_expr_int(parser.expr_store, val), line, col)
    }
    if (kind == tk_float())
    {
        let line = parser_line(parser)
        let col = parser_col(parser)
        let val = parser_float(parser)
        parser_advance(parser)
        return parser_expr_at(parser, ast_expr_float(parser.expr_store, val), line, col)
    }
    if (kind == tk_bool())
    {
        let line = parser_line(parser)
        let col = parser_col(parser)
        let val = parser_int(parser)
        parser_advance(parser)
        return parser_expr_at(parser, ast_expr_bool(parser.expr_store, val), line, col)
    }
    if (kind == tk_string())
    {
        let line = parser_line(parser)
        let col = parser_col(parser)
        let text = parser_text(parser)
        parser_advance(parser)
        return parser_expr_at(parser, ast_expr_string(parser.expr_store, text), line, col)
    }
    if (kind == tk_ident())
    {
        let line = parser_line(parser)
        let col = parser_col(parser)
        let name = parser_text(parser)
        parser_advance(parser)
        if (parser_text(parser) == "{")
        {
            parser_advance(parser)
            let mut field_names: [string] = []
            let mut field_values: [i32] = []
            while (parser_text(parser) != "}" and parser_at_end(parser) == 0)
            {
                if (parser_text(parser) == ",")
                {
                    parser_advance(parser)
                    continue
                }
                let field_name = parser_text(parser)
                if (parser_expect_kind(parser, tk_ident()) == 0) { return -1 }
                parser_expect_text(parser, ":")
                if (parser.ok == 0) { return -1 }
                let field_value = parse_expression(parser)
                if (parser.ok == 0) { return -1 }
                field_names.push(field_name)
                field_values.push(field_value)
                parser_accept_text(parser, ",")
            }
            parser_expect_text(parser, "}")
            if (parser.ok == 0) { return -1 }
            return parser_expr_at(parser, ast_expr_struct_literal(parser.expr_store, name, field_names, field_values), line, col)
        }
        if (parser_text(parser) == "(")
        {
            parser_advance(parser)
            let mut args: [i32] = []
            if (parser_text(parser) != ")")
            {
                let arg = parse_expression(parser)
                if (parser.ok == 0) { return -1 }
                args.push(arg)
                while (parser_text(parser) == ",")
                {
                    parser_advance(parser)
                    let arg2 = parse_expression(parser)
                    if (parser.ok == 0) { return -1 }
                    args.push(arg2)
                }
            }
            parser_expect_text(parser, ")")
            return parser_expr_at(parser, ast_expr_call(parser.expr_store, name, args), line, col)
        }
        return parser_expr_at(parser, ast_expr_identifier(parser.expr_store, name), line, col)
    }
    
    if (parser_text(parser) == "nil")
    {
        let line = parser_line(parser)
        let col = parser_col(parser)
        parser_advance(parser)
        return parser_expr_at(parser, ast_expr_int(parser.expr_store, 0), line, col)
    }
    if (parser_text(parser) == "(")
    {
        parser_advance(parser)
        let expr = parse_expression(parser)
        if (parser.ok == 0) { return -1 }
        parser_expect_text(parser, ")")
        return expr
    }
    parser_fail(parser, "unexpected token in expression: '" + parser_text(parser) + "'")
    return -1
}

pub fn parse_statement_ident(parser: &Parser): i32
{
    if (parser_kind(parser) != tk_ident())
    {
        parser_fail(parser, "unexpected statement: '" + parser_text(parser) + "'")
        return -1
    }
    let line = parser_line(parser)
    let col = parser_col(parser)
    let name = parser_text(parser)
    parser_advance(parser)
    let op = parser_text(parser)
    if (op == "=")
    {
        parser_advance(parser)
        let expr_idx = parse_expression(parser)
        if (parser.ok == 0) { return -1 }
        parser_accept_text(parser, ";")
        return parser_stmt_at(parser, ast_stmt_assign(parser.store, name, expr_idx), line, col)
    }
    if (op == "+=")
    {
        parser_advance(parser)
        let rhs_idx = parse_expression(parser)
        if (parser.ok == 0) { return -1 }
        parser_accept_text(parser, ";")
        let ident_idx = parser_expr_at(parser, ast_expr_identifier(parser.expr_store, name), line, col)
        let binop_idx = parser_expr_at(parser, ast_expr_binop(parser.expr_store, "+", ident_idx, rhs_idx), line, col)
        return parser_stmt_at(parser, ast_stmt_assign(parser.store, name, binop_idx), line, col)
    }
    if (op == "-=")
    {
        parser_advance(parser)
        let rhs_idx = parse_expression(parser)
        if (parser.ok == 0) { return -1 }
        parser_accept_text(parser, ";")
        let ident_idx = parser_expr_at(parser, ast_expr_identifier(parser.expr_store, name), line, col)
        let binop_idx = parser_expr_at(parser, ast_expr_binop(parser.expr_store, "-", ident_idx, rhs_idx), line, col)
        return parser_stmt_at(parser, ast_stmt_assign(parser.store, name, binop_idx), line, col)
    }
    if (op == "(")
    {
        parser_advance(parser)
        let mut args: [i32] = []
        if (parser_text(parser) != ")")
        {
            let arg = parse_expression(parser)
            if (parser.ok == 0) { return -1 }
            args.push(arg)
            while (parser_text(parser) == ",")
            {
                parser_advance(parser)
                let arg2 = parse_expression(parser)
                if (parser.ok == 0) { return -1 }
                args.push(arg2)
            }
        }
        parser_expect_text(parser, ")")
        if (parser.ok == 0) { return -1 }
        parser_accept_text(parser, ";")
        let call_idx = parser_expr_at(parser, ast_expr_call(parser.expr_store, name, args), line, col)
        return parser_stmt_at(parser, ast_stmt_expr(parser.store, call_idx), line, col)
    }
    parser_fail(parser, "unexpected token after identifier: '" + op + "'")
    return -1
}

pub fn parse_block_statement(parser: &Parser): i32
{
    let line = parser_line(parser)
    let col = parser_col(parser)
    if (parser_expect_text(parser, "{") == 0) { return -1 }
    let mut indices: [i32] = []
    while (parser_text(parser) != "}" and parser_at_end(parser) == 0)
    {
        if (parser_text(parser) == ";")
        {
            parser_advance(parser)
            continue
        }
        let stmt_idx = parse_statement(parser)
        if (parser.ok == 0) { return -1 }
        indices.push(stmt_idx)
    }
    if (parser_expect_text(parser, "}") == 0) { return -1 }
    return parser_stmt_at(parser, ast_stmt_block_indices(parser.store, indices), line, col)
}

pub fn parse_if_rest(parser: &Parser): i32
{
    while (parser_text(parser) == ";")
    {
        parser_advance(parser)
    }
    return match parser_text(parser) {
        "else" -> {
            parser_advance(parser)
            let else_idx = parse_block_statement(parser)
            if (parser.ok == 0) { return -1 }
            else_idx
        }
        "elif" -> parse_if_statement(parser)
        _ -> -1
    }
}

pub fn parse_if_statement(parser: &Parser): i32
{
    let line = parser_line(parser)
    let col = parser_col(parser)
    let keyword = parser_text(parser)
    if (keyword != "if" and keyword != "elif")
    {
        parser_fail(parser, "expected if or elif, got '" + keyword + "'")
        return -1
    }
    parser_advance(parser)
    parser_expect_text(parser, "(")
    if (parser.ok == 0) { return -1 }
    let cond_idx = parse_expression(parser)
    if (parser.ok == 0) { return -1 }
    parser_expect_text(parser, ")")
    if (parser.ok == 0) { return -1 }
    let then_idx = parse_block_statement(parser)
    if (parser.ok == 0) { return -1 }
    let else_idx = parse_if_rest(parser)
    if (parser.ok == 0) { return -1 }
    return parser_stmt_at(parser, ast_stmt_if(parser.store, cond_idx, then_idx, else_idx), line, col)
}

pub fn parse_for_statement(parser: &Parser): i32
{
    let line = parser_line(parser)
    let col = parser_col(parser)
    parser_advance(parser)
    parser_expect_text(parser, "(")
    if (parser.ok == 0) { return -1 }
    let name = parser_text(parser)
    if (parser_expect_kind(parser, tk_ident()) == 0) { return -1 }
    parser_expect_text(parser, "in")
    if (parser.ok == 0) { return -1 }
    let start_idx = parse_expression(parser)
    if (parser.ok == 0) { return -1 }
    parser_expect_text(parser, "..")
    if (parser.ok == 0) { return -1 }
    let end_idx = parse_expression(parser)
    if (parser.ok == 0) { return -1 }
    parser_expect_text(parser, ")")
    if (parser.ok == 0) { return -1 }
    let body_idx = parse_block_statement(parser)
    if (parser.ok == 0) { return -1 }
    return parser_stmt_at(parser, ast_stmt_for_range(parser.store, name, start_idx, end_idx, body_idx), line, col)
}

pub fn parse_match_pattern(parser: &Parser): i32
{
    if (parser_text(parser) == "_")
    {
        parser_advance(parser)
        return -1
    }
    return parse_expression(parser)
}

pub fn parse_match_arm_body(parser: &Parser): i32
{
    if (parser_text(parser) == "{")
    {
        return parse_block_statement(parser)
    }
    return parse_statement(parser)
}

pub fn parse_match_arms_desugared(parser: &Parser, subject_name: string): i32
{
    while (parser_text(parser) == ";")
    {
        parser_advance(parser)
    }
    if (parser_text(parser) == "}" or parser_at_end(parser) == 1)
    {
        return ast_stmt_block_indices(parser.store, [])
    }

    let first_pattern = parse_match_pattern(parser)
    if (parser.ok == 0) { return -1 }
    let mut is_default = 0
    if (first_pattern < 0) { is_default = 1 }
    let subject_expr = ast_expr_identifier(parser.expr_store, subject_name)
    let mut cond_idx = if (is_default == 1) { -1 } else { ast_expr_binop(parser.expr_store, "==", subject_expr, first_pattern) }
    while (parser_text(parser) == "|")
    {
        parser_advance(parser)
        let next_pattern = parse_match_pattern(parser)
        if (parser.ok == 0) { return -1 }
        if (next_pattern < 0)
        {
            is_default = 1
        }
        else
        {
            let next_subject_expr = ast_expr_identifier(parser.expr_store, subject_name)
            let next_cond = ast_expr_binop(parser.expr_store, "==", next_subject_expr, next_pattern)
            if (cond_idx < 0)
            {
                cond_idx = next_cond
            }
            else
            {
                cond_idx = ast_expr_binop(parser.expr_store, "or", cond_idx, next_cond)
            }
        }
    }
    parser_expect_text(parser, "->")
    if (parser.ok == 0) { return -1 }
    let body_idx = parse_match_arm_body(parser)
    if (parser.ok == 0) { return -1 }
    parser_accept_text(parser, ",")
    while (parser_text(parser) == ";")
    {
        parser_advance(parser)
    }
    if (is_default == 1 or cond_idx < 0)
    {
        return body_idx
    }
    let else_idx = parse_match_arms_desugared(parser, subject_name)
    if (parser.ok == 0) { return -1 }
    let cond = expr_store_get(parser.expr_store, cond_idx)
    return parser_stmt_at(parser, ast_stmt_if(parser.store, cond_idx, body_idx, else_idx), cond.line, cond.col)
}

pub fn parse_match_statement(parser: &Parser): i32
{
    let line = parser_line(parser)
    let col = parser_col(parser)
    parser_expect_text(parser, "match")
    if (parser.ok == 0) { return -1 }
    let mut subject_idx = -1
    if (parser_kind(parser) == tk_ident() and stream_text_at(parser.stream, parser.pos + 1) == "{")
    {
        let subject_name = parser_text(parser)
        parser_advance(parser)
        subject_idx = ast_expr_identifier(parser.expr_store, subject_name)
    }
    else
    {
        subject_idx = parse_expression(parser)
    }
    if (parser.ok == 0) { return -1 }
    parser_expect_text(parser, "{")
    if (parser.ok == 0) { return -1 }
    let tmp_name = "__match" + ast_i32(parser.pos)
    let body_idx = parse_match_arms_desugared(parser, tmp_name)
    if (parser.ok == 0) { return -1 }
    parser_expect_text(parser, "}")
    if (parser.ok == 0) { return -1 }
    let bind_idx = parser_stmt_at(parser, ast_stmt_let(parser.store, tmp_name, subject_idx), line, col)
    return parser_stmt_at(parser, ast_stmt_block_indices(parser.store, [bind_idx, body_idx]), line, col)
}

pub fn parse_statement(parser: &Parser): i32
{
    let line = parser_line(parser)
    let col = parser_col(parser)
    if (parser_text(parser) == "match")
    {
        return parse_match_statement(parser)
    }
    return match parser_text(parser) {
        "@" -> {
            parser_advance(parser)
            let pointer_idx = parse_unary(parser)
            if (parser.ok == 0) { return -1 }
            parser_expect_text(parser, "=")
            if (parser.ok == 0) { return -1 }
            let expr_idx = parse_expression(parser)
            if (parser.ok == 0) { return -1 }
            parser_accept_text(parser, ";")
            parser_stmt_at(parser, ast_stmt_store_deref(parser.store, pointer_idx, expr_idx), line, col)
        }
        "let" -> {
            parser_advance(parser)
            let mut is_mut = 0
            if (parser_text(parser) == "mut")
            {
                is_mut = 1
                parser_advance(parser)
            }
            let name = parser_text(parser)
            if (parser_expect_kind(parser, tk_ident()) == 0) { return -1 }
            let mut type_text = ""
            if (parser_text(parser) == ":")
            {
                parser_advance(parser)
                type_text = parser_text(parser)
                parser_advance(parser)
            }
            parser_expect_text(parser, "=")
            if (parser.ok == 0) { return -1 }
            let expr_idx = parse_expression(parser)
            if (parser.ok == 0) { return -1 }
            parser_accept_text(parser, ";")
            parser_stmt_at(parser, ast_stmt_let_typed_mut(parser.store, name, type_text, expr_idx, is_mut), line, col)
        }
        "return" -> {
            parser_advance(parser)
            if (parser_text(parser) == ";" or parser_text(parser) == "}" or parser_at_end(parser) == 1)
            {
                parser_accept_text(parser, ";")
                parser_stmt_at(parser, ast_stmt_return(parser.store, parser.expr_store, 0), line, col)
            }
            else
            {
                let expr_idx = parse_expression(parser)
                if (parser.ok == 0) { return -1 }
                parser_accept_text(parser, ";")
                parser_stmt_at(parser, ast_stmt_return_expr(parser.store, expr_idx), line, col)
            }
        }
        "print" -> {
            parser_advance(parser)
            parser_expect_text(parser, "(")
            if (parser.ok == 0) { return -1 }
            let expr_idx = parse_expression(parser)
            if (parser.ok == 0) { return -1 }
            parser_expect_text(parser, ")")
            if (parser.ok == 0) { return -1 }
            parser_accept_text(parser, ";")
            parser_stmt_at(parser, ast_stmt_print(parser.store, expr_idx), line, col)
        }
        "while" -> {
            parser_advance(parser)
            parser_expect_text(parser, "(")
            if (parser.ok == 0) { return -1 }
            let cond_idx = parse_expression(parser)
            if (parser.ok == 0) { return -1 }
            parser_expect_text(parser, ")")
            if (parser.ok == 0) { return -1 }
            let body_idx = parse_block_statement(parser)
            if (parser.ok == 0) { return -1 }
            parser_stmt_at(parser, ast_stmt_while(parser.store, cond_idx, body_idx), line, col)
        }
        "if" -> parse_if_statement(parser)
        "for" -> parse_for_statement(parser)
        "break" | "continue" -> {
            let tag = parser_text(parser)
            parser_advance(parser)
            parser_accept_text(parser, ";")
            parser_stmt_at(parser, ast_stmt_loop_control(parser.store, tag), line, col)
        }
        _ -> parse_statement_ident(parser)
    }
}

pub fn parse_function(parser: &Parser): AstFunction
{
    let line = parser_line(parser)
    let col = parser_col(parser)
    if (parser_text(parser) == "pub") { parser_advance(parser) }
    if (parser_expect_text(parser, "fn") == 0) { return ast_function("main", "i32", -1) }
    let name = parser_text(parser)
    if (parser_expect_kind(parser, tk_ident()) == 0) { return ast_function("main", "i32", -1) }
    if (parser_expect_text(parser, "(") == 0) { return ast_function("main", "i32", -1) }

    let mut param_names: [string] = []
    let mut param_types: [string] = []
    if (parser_text(parser) != ")")
    {
        let param_name = parser_text(parser)
        if (parser_expect_kind(parser, tk_ident()) == 0) { return ast_function("main", "i32", -1) }
        if (parser_expect_text(parser, ":") == 0) { return ast_function("main", "i32", -1) }
        let param_ty = parser_text(parser)
        parser_advance(parser)
        param_names.push(param_name)
        param_types.push(param_ty)
        while (parser_text(parser) == ",")
        {
            parser_advance(parser)
            let next_name = parser_text(parser)
            if (parser_expect_kind(parser, tk_ident()) == 0) { return ast_function("main", "i32", -1) }
            if (parser_expect_text(parser, ":") == 0) { return ast_function("main", "i32", -1) }
            let next_ty = parser_text(parser)
            parser_advance(parser)
            param_names.push(next_name)
            param_types.push(next_ty)
        }
    }
    if (parser_expect_text(parser, ")") == 0) { return ast_function("main", "i32", -1) }
    let mut ret_ty = "void"
    if (parser_text(parser) == ":")
    {
        parser_advance(parser)
        ret_ty = parser_text(parser)
        parser_advance(parser)
    }
    let mut body_idx = parse_block_statement(parser)
    if (parser.ok == 0) { return ast_function("main", "i32", -1) }
    if (body_idx < 0)
    {
        body_idx = ast_stmt_return(parser.store, parser.expr_store, 0)
    }
    return ast_function_with_loc(ast_function_full(name, ret_ty, body_idx, param_names, param_types), line, col)
}

pub fn parse_function_params_and_return(parser: &Parser, name: string): AstFunction
{
    let mut param_names: [string] = []
    let mut param_types: [string] = []
    let mut is_var_arg = 0
    if (parser_text(parser) != ")")
    {
        if (parser_text(parser) == "...")
        {
            is_var_arg = 1
            parser_advance(parser)
        }
        else
        {
            let param_name = parser_text(parser)
            if (parser_expect_kind(parser, tk_ident()) == 0) { return ast_function(name, "i32", -1) }
            if (parser_expect_text(parser, ":") == 0) { return ast_function(name, "i32", -1) }
            let param_ty = parser_text(parser)
            parser_advance(parser)
            param_names.push(param_name)
            param_types.push(param_ty)
            while (parser_text(parser) == ",")
            {
                parser_advance(parser)
                if (parser_text(parser) == "...")
                {
                    is_var_arg = 1
                    parser_advance(parser)
                    break
                }
                let next_name = parser_text(parser)
                if (parser_expect_kind(parser, tk_ident()) == 0) { return ast_function(name, "i32", -1) }
                if (parser_expect_text(parser, ":") == 0) { return ast_function(name, "i32", -1) }
                let next_ty = parser_text(parser)
                parser_advance(parser)
                param_names.push(next_name)
                param_types.push(next_ty)
            }
        }
    }
    if (parser_expect_text(parser, ")") == 0) { return ast_function(name, "i32", -1) }
    let mut ret_ty = "void"
    if (parser_text(parser) == ":")
    {
        parser_advance(parser)
        ret_ty = parser_text(parser)
        parser_advance(parser)
    }
    return ast_function_full_vararg(name, ret_ty, -1, param_names, param_types, is_var_arg)
}

pub fn parse_extern_function(parser: &Parser): AstFunction
{
    let line = parser_line(parser)
    let col = parser_col(parser)
    if (parser_expect_text(parser, "fn") == 0) { return ast_function("", "i32", -1) }
    let name = parser_text(parser)
    if (parser_expect_kind(parser, tk_ident()) == 0) { return ast_function("", "i32", -1) }
    if (parser_expect_text(parser, "(") == 0) { return ast_function(name, "i32", -1) }
    let func = parse_function_params_and_return(parser, name)
    parser_accept_text(parser, ";")
    return ast_function_with_loc(func, line, col)
}

pub fn parse_extern_block(parser: &Parser): AstFunction
{
    parser_expect_text(parser, "extern")
    if (parser.ok == 0) { return ast_function("", "i32", -1) }
    if (parser_kind(parser) == tk_string())
    {
        parser_advance(parser)
    }
    parser_expect_text(parser, "{")
    if (parser.ok == 0) { return ast_function("", "i32", -1) }
    if (parser_text(parser) == ";")
    {
        parser_advance(parser)
    }
    let func = parse_extern_function(parser)
    if (parser.ok == 0) { return ast_function("", "i32", -1) }
    while (parser_text(parser) == ";")
    {
        parser_advance(parser)
    }
    parser_expect_text(parser, "}")
    return func
}

pub fn parse_struct_decl(parser: &Parser): AstStructDecl
{
    let line = parser_line(parser)
    let col = parser_col(parser)
    parser_expect_text(parser, "type")
    if (parser.ok == 0) { return AstStructDecl{ name: "", field_names: [], field_types: [], line: line, col: col } }
    let name = parser_text(parser)
    if (parser_expect_kind(parser, tk_ident()) == 0) { return AstStructDecl{ name: "", field_names: [], field_types: [], line: line, col: col } }
    parser_expect_text(parser, "=")
    if (parser.ok == 0) { return AstStructDecl{ name: name, field_names: [], field_types: [], line: line, col: col } }
    parser_expect_text(parser, "struct")
    if (parser.ok == 0) { return AstStructDecl{ name: name, field_names: [], field_types: [], line: line, col: col } }
    parser_expect_text(parser, "{")
    if (parser.ok == 0) { return AstStructDecl{ name: name, field_names: [], field_types: [], line: line, col: col } }
    let mut field_names: [string] = []
    let mut field_types: [string] = []
    while (parser_text(parser) != "}" and parser_at_end(parser) == 0)
    {
        if (parser_text(parser) == ",")
        {
            parser_advance(parser)
            continue
        }
        let field_name = parser_text(parser)
        if (parser_expect_kind(parser, tk_ident()) == 0) { return AstStructDecl{ name: name, field_names: field_names, field_types: field_types, line: line, col: col } }
        parser_expect_text(parser, ":")
        if (parser.ok == 0) { return AstStructDecl{ name: name, field_names: field_names, field_types: field_types, line: line, col: col } }
        let field_type = parser_text(parser)
        parser_advance(parser)
        field_names.push(field_name)
        field_types.push(field_type)
        parser_accept_text(parser, ",")
    }
    parser_expect_text(parser, "}")
    return AstStructDecl{ name: name, field_names: field_names, field_types: field_types, line: line, col: col }
}

pub fn parse_program(src: string, filename: string): AstProgram
{
    let mut parser = parser_new(src, filename)
    if (parser_at_end(&parser) == 1) { return ast_program_err("empty source") }
    let mut functions: [AstFunction] = []
    let mut extern_functions: [AstFunction] = []
    let mut structs: [AstStructDecl] = []
    while (parser_text(&parser) == "extern")
    {
        parser_expect_text(&parser, "extern")
        if (parser.ok == 0) { return ast_program_err(parser.error) }
        if (parser_kind(&parser) == tk_string())
        {
            parser_advance(&parser)
        }
        parser_expect_text(&parser, "{")
        if (parser.ok == 0) { return ast_program_err(parser.error) }
        while (parser_text(&parser) != "}" and parser_at_end(&parser) == 0)
        {
            if (parser_text(&parser) == ";")
            {
                parser_advance(&parser)
                continue
            }
            let extern_func = parse_extern_function(&parser)
            if (parser.ok == 0) { return ast_program_err(parser.error) }
            extern_functions.push(extern_func)
        }
        parser_expect_text(&parser, "}")
        if (parser.ok == 0) { return ast_program_err(parser.error) }
    }
    while (parser_text(&parser) == "type")
    {
        let decl = parse_struct_decl(&parser)
        if (parser.ok == 0) { return ast_program_err(parser.error) }
        structs.push(decl)
        while (parser_text(&parser) == ";") { parser_advance(&parser) }
    }
    if (parser_text(&parser) != "fn" and parser_text(&parser) != "pub")
    {
        return ast_program_err("expected function")
    }
    let first_func = parse_function(&parser)
    if (parser.ok == 0) { return ast_program_err(parser.error) }
    functions.push(first_func)
    while (parser_text(&parser) == "fn" or parser_text(&parser) == "pub")
    {
        let func = parse_function(&parser)
        if (parser.ok == 0) { return ast_program_err(parser.error) }
        functions.push(func)
    }
    return ast_program_ok_functions_with_externs_and_structs(functions, extern_functions, structs, parser.expr_store, parser.store)
}
