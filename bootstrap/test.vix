type Point = struct 
{
    x:i32,
    s:string,
    y:i32
}


fn main(): i32
{
    let p = Point{x:2,s:"Hello",y:2}
    print(p.x)
    print(p.s)
    let mut a = 10
    while(a > 0)
    {
        a = a - 1
        print(a)
    }
    match a 
    {
        1 -> print(a)
        _ -> print("0")
    }
    return 0
}
