#[no_main]
import "lexer.vix"

pub type ImportSet = struct {
    paths: [string]
}

pub fn import_set_new(): ImportSet
{
    return ImportSet{ paths: [] }
}

pub fn import_set_contains(imports: &ImportSet, path: string): i32
{
    for (i in 0 .. imports.paths.length)
    {
        if (imports.paths[i] == path) { return 1 }
    }
    return 0
}

pub fn import_set_add(imports: &ImportSet, path: string)
{
    if (import_set_contains(imports, path) == 1) { return }
    imports.paths.push(path)
}

pub fn read_file_content(path: string): string
{
    let file = fopen(path, "r")
    if (file == 0) { return "" }
    fseek(file, 0, 2)
    let size = ftell(file)
    fseek(file, 0, 0)
    let buf = malloc(size + 1)
    let n = fread(buf, 1, size, file)
    buf[n] = 0
    fclose(file)
    return buf
}

pub fn resolve_import_path(importer: string, import_path: string): string
{
    let mut last_slash = -1
    for (i in 0 .. importer.length)
    {
        if (importer[i] == '/') { last_slash = i }
    }
    if (last_slash < 0)
    {
        return import_path
    }
    let mut dir = ""
    for (i in 0 .. (last_slash + 1))
    {
        dir = dir + char_string(importer[i])
    }
    return dir + import_path
}

pub fn skip_attr_line(src: string, start: i32): i32
{
    let mut i = start
    while (i < src.length and src[i] != ']') { i += 1 }
    if (i < src.length) { i += 1 }
    let mut done = 0
    while (i < src.length and done == 0)
    {
        if (src[i] == 10)
        {
            i += 1
            done = 1
        }
        elif (src[i] != 32 and src[i] != 9 and src[i] != 13)
        {
            done = 1
        }
        else
        {
            i += 1
        }
    }
    return i
}

pub fn scan_import_line(src: string, start: i32): i32
{
    if (start > 0)
    {
        let mut j = start - 1
        while (j >= 0 and src[j] != 10)
        {
            if (src[j] != 32 and src[j] != 9 and src[j] != 13) { return -1 }
            j -= 1
        }
    }
    let mut i = start
    if (i + 6 > src.length) { return -1 }
    let keyword = "import"
    for (k in 0 .. 6)
    {
        if (src[i + k] != keyword[k]) { return -1 }
    }
    i += 6
    while (i < src.length and (src[i] == 32 or src[i] == 9)) { i += 1 }
    if (i >= src.length or src[i] != '"') { return -1 }
    i += 1
    while (i < src.length and src[i] != 10 and src[i] != '"') { i += 1 }
    if (i >= src.length or src[i] != '"') { return -1 }
    i += 1
    while (i < src.length and src[i] != 10) { i += 1 }
    if (i < src.length) { i += 1 }
    return i
}

pub fn extract_import_path(src: string, start: i32): string
{
    let mut i = start + 6
    while (i < src.length and (src[i] == 32 or src[i] == 9)) { i += 1 }
    if (i >= src.length or src[i] != '"') { return "" }
    i += 1
    let mut path = ""
    while (i < src.length and src[i] != '"')
    {
        path = path + char_string(src[i])
        i += 1
    }
    return path
}

pub fn slice_text(src: string, start: i32, end: i32): string
{
    let len = end - start
    let out = malloc(len + 1)
    let mut j = 0
    for (i in start .. end)
    {
        out[j] = src[i]
        j += 1
    }
    out[len] = 0
    return out
}

pub fn preprocess_source(src: string, filename: string, imports: &ImportSet): string
{
    let mut out = ""
    let mut i = 0
    let mut segment_start = 0
    
    while (i < src.length)
    {
        if (src[i] == '#' and i + 1 < src.length and src[i + 1] == '[')
        {
            if (segment_start < i)
            {
                out = out + slice_text(src, segment_start, i)
            }
            i = skip_attr_line(src, i)
            segment_start = i
            continue
        }
        
        let import_end = scan_import_line(src, i)
        if (import_end > i)
        {
            if (segment_start < i)
            {
                out = out + slice_text(src, segment_start, i)
            }
            let path = extract_import_path(src, i)
            if (path != "")
            {
                if (import_set_contains(imports, path) == 0)
                {
                    import_set_add(imports, path)
                    let resolved = resolve_import_path(filename, path)
                    let content = read_file_content(resolved)
                    if (content != "")
                    {
                        let processed = preprocess_source(content, path, imports)
                        out = out + processed + "\n"
                    }
                }
            }
            i = import_end
            segment_start = i
            continue
        }
        
        i += 1
    }
    if (segment_start < src.length)
    {
        out = out + slice_text(src, segment_start, src.length)
    }
    return out
}
