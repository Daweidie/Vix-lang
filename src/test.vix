extern "C"
{
	fn malloc(size: usize): ptr
	fn free(ptr: ptr): void
}
fn strconcat(a:ptr,b:ptr): ptr
{
	let mut i = 0
	let mut j = 0
	let mut result = malloc(a.length + b.length + 1)
	while (a[i] != 0)
	{
		result[j] = a[i]
		i += 1
		j += 1
	}
	i = 0
	while (b[i] != 0)
	{
		result[j] = b[i]
		i += 1
		j += 1
	}
	result[j] = 0
	return result
}
fn main(): i32
{
	let a = "Hello"
	let b = "World"
	let c = strconcat(a, b)
	print(c)
	free(c)
	return 0
}