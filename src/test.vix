type Point = struct
{
	x: i32,
	y: i32
}
fn add_point(points:[Point], p: Point): i32
{
    let id = points.length
    points.push(p)
    return id
}

fn build_points(): [Point]
{
    let mut pts: [Point] = []
    let id1 = add_point(pts, Point{ x: 1, y: 2 })
    let id2 = add_point(pts, Point{ x: 3, y: 4 })
    return pts
}

fn main(): i32
{
	let points = build_points()
	for(p in points)
	{
		print(p.x, p.y)
	}
	return 0
}