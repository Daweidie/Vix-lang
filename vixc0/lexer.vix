pub type Result:[T, E] = Ok(T) | Err(E)

pub type TokenKind =  Identifier
    | Number
    | String
    | Keyword
    | Symbol
    | EOF

pub type Token = struct 
{
    kind:TokenKind,
    value:string,
    line:u32,
    column:u32

}

fn skip_ws(src:string,pos:i32): i32
{
    let mut i = pos
    while(i < src.length and (src[i] == ' ' or src[i] == '\t' or src[i] == '\n' or src[i] == '\r'))
    {
        i += 1
    }
    return i
}

fn tokenize(src:string): Result:[Token,string]
{
    return Err("not implemented")
}