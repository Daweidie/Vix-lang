pub type Result:[T, E] = Ok(T) | Err(E)

pub struct Token
{
    kind: string,
    value: string
}

pub type Tokens = TkFn | TkIdent | TkNumber | TkString | TkSymbol
pub struct TkFn
{
    name: string,
    params: list[string],
    return_type: string
}

fn skip_ws(src:string, pos:i32): i32
{
    while (pos < src.length and (src[pos] == ' ' or src[pos] == '\t' or src[pos] == '\n' or src[pos] == '\r'))
    {
        pos += 1
    }
    for(i in 0 .. src.length)
    {
        printf("next char: '%c'\n", src[i])
    }
    return pos
}

fn lex(src:string): Result[Token, string]
{
    let pos = 0
    pos = skip_ws(src, pos)
    if(pos >= src.length)
    {
        return OK[Token]({ kind: "EOF", value: "" })
