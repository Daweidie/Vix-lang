pub fn llvm_emit_neg(b: &LlvmBuilder, result: string, src: string)
{
    let src_val = vix_LLVMBuildLoad2(b.builder, LLVMInt32Type(), get_var(b, src), "load_src")
    let res = vix_LLVMBuildNeg(b.builder, src_val, result)
    let alloca = vix_LLVMBuildAlloca(b.builder, LLVMInt32Type(), result)
    set_var(b, result, alloca)
    vix_LLVMBuildStore(b.builder, res, alloca)
}

pub fn llvm_emit_eq(b: &LlvmBuilder, result: string, left: string, right: string)
{
    let left_val = vix_LLVMBuildLoad2(b.builder, LLVMInt32Type(), get_var(b, left), "load_left")
    let right_val = vix_LLVMBuildLoad2(b.builder, LLVMInt32Type(), get_var(b, right), "load_right")
    let cmp = vix_LLVMBuildICmp(b.builder, 32, left_val, right_val, result)
    let alloca = vix_LLVMBuildAlloca(b.builder, LLVMInt1Type(), result)
    set_var(b, result, alloca)
    vix_LLVMBuildStore(b.builder, cmp, alloca)
}

