#[no_main]

extern "C"
{
    fn malloc(size: usize): string
    fn snprintf(buf: string, size: usize, fmt: string, ...): i32
}

pub fn i32_to_str(n: i32): string
{
    let buf: string = malloc(64)
    snprintf(buf, 64, "%d", n)
    return buf
}

pub type QbeDataString = struct {
    label: string,
    value: string
}

pub type QbeCallArg = struct {
    ty: string,
    value: string
}

pub type QbeInstr = struct {
    tag: string,
    result: string,
    ty: string,
    func: string,
    op: string,
    left: string,
    right: string,
    value: string,
    label: string,
    then_label: string,
    else_label: string,
    comment: string,
    args: [QbeCallArg],
    int_value: i32
}

pub type QbeBuilder = struct {
    data_defs: [QbeDataString],
    instrs: [QbeInstr],
    temp_counter: i32,
    label_counter: i32
}

pub fn qbe_new(): QbeBuilder
{
    return QbeBuilder{ data_defs: [], instrs: [], temp_counter: 0, label_counter: 0 }
}

pub fn qbe_get_code(b: &QbeBuilder): string
{
    return qbe_render(b)
}

pub fn qbe_temp(b: &QbeBuilder, prefix: string): string
{
    let val = b.temp_counter
    b.temp_counter = val + 1
    return "%" + prefix + i32_to_str(val)
}

pub fn qbe_label_name(b: &QbeBuilder, prefix: string): string
{
    let val = b.label_counter
    b.label_counter = val + 1
    return prefix + i32_to_str(val)
}

pub fn qbe_push_instr(b: &QbeBuilder, instr: QbeInstr)
{
    b.instrs.push(instr)
}

pub fn qbe_push_call_args_from_strings(values: [string]): [QbeCallArg]
{
    let mut args: [QbeCallArg] = []
    for (i in 0 .. values.length)
    {
        args.push(QbeCallArg{ ty: "w", value: values[i] })
    }
    return args
}

pub fn qbe_emit_data_string(b: &QbeBuilder, label: string, value: string)
{
    b.data_defs.push(QbeDataString{ label: label, value: value })
}

pub fn qbe_emit_function_header(b: &QbeBuilder, name: string, ret_ty: string)
{
    qbe_push_instr(b, QbeInstr{ tag: "function_header", result: "", ty: ret_ty, func: name, op: "", left: "", right: "", value: "", label: "", then_label: "", else_label: "", comment: "", args: [], int_value: 0 })
}

pub fn qbe_emit_end_function(b: &QbeBuilder)
{
    qbe_push_instr(b, QbeInstr{ tag: "function_end", result: "", ty: "", func: "", op: "", left: "", right: "", value: "", label: "", then_label: "", else_label: "", comment: "", args: [], int_value: 0 })
}

pub fn qbe_emit_label(b: &QbeBuilder, name: string)
{
    qbe_push_instr(b, QbeInstr{ tag: "label", result: "", ty: "", func: "", op: "", left: "", right: "", value: "", label: name, then_label: "", else_label: "", comment: "", args: [], int_value: 0 })
}

