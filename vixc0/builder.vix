{
    let left_val = vix_LLVMBuildLoad2(b.builder, LLVMInt32Type(), get_var(b, left), "load_left")
    let right_val = vix_LLVMBuildLoad2(b.builder, LLVMInt32Type(), get_var(b, right), "load_right")
    let cmp = vix_LLVMBuildICmp(b.builder, 43, left_val, right_val, result)
    let alloca = vix_LLVMBuildAlloca(b.builder, LLVMInt1Type(), result)
