pub fn llvm_emit_jnz(b: &LlvmBuilder, temp: string, then_label: string, else_label: string)
{
    let cond = vix_LLVMBuildLoad2(b.builder, LLVMInt1Type(), get_var(b, temp), "load_cond")
    let then_block = vix_LLVMAppendBasicBlock(b.current_fn, then_label)
    let else_block = vix_LLVMAppendBasicBlock(b.current_fn, else_label)
    vix_LLVMBuildCondBr(b.builder, cond, then_block, else_block)
}

pub fn llvm_emit_jmp(b: &LlvmBuilder, label: string)
{
    let block = vix_LLVMAppendBasicBlock(b.current_fn, label)
    vix_LLVMBuildBr(b.builder, block)
}

pub fn llvm_emit_alloc4(b: &LlvmBuilder, result: string)
{
    let alloca = vix_LLVMBuildAlloca(b.builder, LLVMInt32Type(), result)
    set_var(b, result, alloca)
}

pub fn llvm_emit_storew(b: &LlvmBuilder, value: string, target: string)
{
    let val_ptr = get_var(b, value)
    let val = vix_LLVMBuildLoad2(b.builder, LLVMInt32Type(), val_ptr, "load_storew_val")
    let ptr = get_var(b, target)
    vix_LLVMBuildStore(b.builder, val, ptr)
}

pub fn llvm_emit_loadw(b: &LlvmBuilder, result: string, source: string)
{
    let ptr = get_var(b, source)
    let val = vix_LLVMBuildLoad2(b.builder, LLVMInt32Type(), ptr, result)
    let alloca = vix_LLVMBuildAlloca(b.builder, LLVMInt32Type(), result)
    set_var(b, result, alloca)
    vix_LLVMBuildStore(b.builder, val, alloca)
}

pub fn llvm_emit_comment(b: &LlvmBuilder, text: string)
{
    let _ = text
}

pub fn llvm_emit_call(b: &LlvmBuilder, result: string, func: string, args: [string])
{
    let mut fn_ref = vix_LLVMGetNamedFunction(b.module, func)
    if (fn_ref == nil)
    {
        let fn_ty = vix_LLVMFunctionType0(LLVMInt32Type(), 0)
        fn_ref = vix_LLVMAddFunction(b.module, func, fn_ty)
    }
    let call_val = vix_LLVMBuildCall2(b.builder, vix_LLVMFunctionType0(LLVMInt32Type(), 0), fn_ref, 0, 0, result)
    if (result != "")
    {
        let alloca = vix_LLVMBuildAlloca(b.builder, LLVMInt32Type(), result)
        set_var(b, result, alloca)
        vix_LLVMBuildStore(b.builder, call_val, alloca)
    }
}

pub fn llvm_emit_call_void(b: &LlvmBuilder, func: string, args: [string])
{
    let mut fn_ref = vix_LLVMGetNamedFunction(b.module, func)
    if (fn_ref == nil)
    {
        let fn_ty = vix_LLVMFunctionType0(LLVMVoidType(), 0)
        fn_ref = vix_LLVMAddFunction(b.module, func, fn_ty)
    }
    let _ = vix_LLVMBuildCall2(b.builder, vix_LLVMFunctionType0(LLVMVoidType(), 0), fn_ref, 0, 0, "")
}

pub fn llvm_emit_printf_i32(b: &LlvmBuilder, value: string)
{
    let fmt_ptr = get_fmt_string(b)
    let val = vix_LLVMBuildLoad2(b.builder, LLVMInt32Type(), get_var(b, value), "load_val")
    let args = [fmt_ptr, val]
    let _ = vix_LLVMBuildCall2(b.builder, vix_LLVMFunctionType1(LLVMInt32Type(), LLVMPointerType(LLVMInt8Type(), 0), 1), b.printf_fn, args, 2, "")
}

pub fn llvm_emit_eq_string(b: &LlvmBuilder, result: string, left: string, right_literal: string)
{
    let cmp = vix_LLVMBuildICmp(b.builder, 32, vix_LLVMConstInt(LLVMInt32Type(), 0, 0), vix_LLVMConstInt(LLVMInt32Type(), 0, 0), result)
    let alloca = vix_LLVMBuildAlloca(b.builder, LLVMInt1Type(), result)
    set_var(b, result, alloca)
    vix_LLVMBuildStore(b.builder, cmp, alloca)
}