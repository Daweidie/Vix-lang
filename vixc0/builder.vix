{
    let left_val = vix_LLVMBuildLoad2(b.builder, LLVMInt32Type(), get_var(b, left), "load_left")
    let right_val = vix_LLVMBuildLoad2(b.builder, LLVMInt32Type(), get_var(b, right), "load_right")
    let res = vix_LLVMBuildSub(b.builder, left_val, right_val, result)
    let alloca = vix_LLVMBuildAlloca(b.builder, LLVMInt32Type(), result)
    set_var(b, result, alloca)
    vix_LLVMBuildStore(b.builder, res, alloca)
}

