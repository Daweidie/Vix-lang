#[no_main]

extern "C"
{
    fn malloc(size: usize): string
    fn snprintf(buf: string, size: usize, fmt: string, ...): i32

    fn LLVMModuleCreateWithName(module_id: string): ptr
    fn LLVMCreateBuilder(): ptr
    fn LLVMDisposeModule(module: ptr)
    fn LLVMDisposeBuilder(builder: ptr)
    fn LLVMPrintModuleToString(module: ptr): string
    fn LLVMVoidType(): ptr
    fn LLVMInt1Type(): ptr
    fn LLVMInt32Type(): ptr
    fn LLVMInt64Type(): ptr
    fn LLVMInt8Type(): ptr
    fn LLVMPointerType(element_ty: ptr, address_space: i32): ptr

    fn vix_LLVMFunctionType0(ret_ty: ptr, is_var_arg: i32): ptr
    fn vix_LLVMFunctionType1(ret_ty: ptr, p0: ptr, is_var_arg: i32): ptr
    fn vix_LLVMFunctionType2(ret_ty: ptr, p0: ptr, p1: ptr, is_var_arg: i32): ptr
    fn vix_LLVMFunctionTypeI32N(ret_ty: ptr, param_count: i32, is_var_arg: i32): ptr
    fn vix_LLVMConstInt(ty: ptr, val: i64, sign_extend: i32): ptr
    fn vix_LLVMAddFunction(module: ptr, name: string, ty: ptr): ptr
    fn vix_LLVMGetParam(fn_ref: ptr, index: i32): ptr
    fn vix_LLVMGetNamedFunction(module: ptr, name: string): ptr
    fn vix_LLVMGetNamedGlobal(module: ptr, name: string): ptr
    fn vix_LLVMAddGlobal(module: ptr, ty: ptr, name: string): ptr
    fn vix_LLVMConstString(str: string, length: i32, dont_null_terminate: i32): ptr
    fn vix_LLVMArrayType(element_ty: ptr, count: i32): ptr
    fn vix_LLVMAppendBasicBlock(fn_ref: ptr, name: string): ptr
    fn vix_LLVMPositionBuilderAtEnd(builder: ptr, block: ptr)
    fn vix_LLVMGetBasicBlockTerminator(block: ptr): ptr
    fn vix_LLVMBuildAdd(builder: ptr, left: ptr, right: ptr, name: string): ptr
    fn vix_LLVMBuildSub(builder: ptr, left: ptr, right: ptr, name: string): ptr
    fn vix_LLVMBuildMul(builder: ptr, left: ptr, right: ptr, name: string): ptr
    fn vix_LLVMBuildSDiv(builder: ptr, left: ptr, right: ptr, name: string): ptr
    fn vix_LLVMBuildSRem(builder: ptr, left: ptr, right: ptr, name: string): ptr
    fn vix_LLVMBuildNeg(builder: ptr, val: ptr, name: string): ptr
    fn vix_LLVMBuildRet(builder: ptr, val: ptr): ptr
    fn vix_LLVMBuildRetVoid(builder: ptr): ptr
    fn vix_LLVMBuildCall2(builder: ptr, ty: ptr, fn_ref: ptr, args: ptr, arg_count: i32, name: string): ptr
    fn vix_LLVMBuildAlloca(builder: ptr, ty: ptr, name: string): ptr
    fn vix_LLVMBuildStore(builder: ptr, val: ptr, ptr_val: ptr): ptr
    fn vix_LLVMBuildLoad2(builder: ptr, ty: ptr, ptr_val: ptr, name: string): ptr
    fn vix_LLVMBuildICmp(builder: ptr, op: i32, left: ptr, right: ptr, name: string): ptr
    fn vix_LLVMBuildZExt(builder: ptr, val: ptr, dest_ty: ptr, name: string): ptr
    fn vix_LLVMBuildBr(builder: ptr, block: ptr): ptr
    fn vix_LLVMBuildCondBr(builder: ptr, cond: ptr, then_block: ptr, else_block: ptr): ptr
    fn vix_LLVMBuildGEP2(builder: ptr, ty: ptr, pointer: ptr, indices: ptr, num_indices: i32, name: string): ptr
    fn vix_LLVMSetInitializer(global: ptr, val: ptr)
    fn vix_LLVMSetGlobalConstant(global: ptr, is_constant: i32)
    fn vix_LLVMSetLinkage(global: ptr, linkage: i32)

    fn vix_reset_vars()
    fn vix_set_var(name: string, value: ptr)
    fn vix_get_var(name: string): ptr
}

pub fn i32_to_str(n: i32): string
{
    let buf: string = malloc(64)
    snprintf(buf, 64, "%d", n)
    return buf
}

pub fn i32_to_i64(n: i32): i64
{
    return n
}

pub type LlvmVarEntry = struct {
    name: string,
    value: ptr
}

pub type LlvmBuilder = struct {
    module: ptr,
    builder: ptr,
    current_fn: ptr,
    current_block: ptr,
    temp_counter: i32,
    label_counter: i32,
    printf_fn: ptr,
    malloc_fn: ptr
}

pub fn get_var(b: &LlvmBuilder, name: string): ptr
{
    let var = vix_get_var(name)
    if (var != nil)
    {
        return var
    }
    return vix_LLVMGetNamedFunction(b.module, name)
}

pub fn set_var(b: &LlvmBuilder, name: string, value: ptr)
{
    vix_set_var(name, value)
}

pub fn get_fmt_string(b: &LlvmBuilder): ptr
{
    let mut global = vix_LLVMGetNamedGlobal(b.module, ".str")
    if (global == nil)
    {
        let str_val = vix_LLVMConstString("%d\n", 3, 0)
        let str_ty = vix_LLVMArrayType(LLVMInt8Type(), 4)
        global = vix_LLVMAddGlobal(b.module, str_ty, ".str")
        vix_LLVMSetInitializer(global, str_val)
        vix_LLVMSetGlobalConstant(global, 1)
        vix_LLVMSetLinkage(global, 8)
    }
    let indices = [vix_LLVMConstInt(LLVMInt32Type(), 0, 0), vix_LLVMConstInt(LLVMInt32Type(), 0, 0)]
    return vix_LLVMBuildGEP2(b.builder, vix_LLVMArrayType(LLVMInt8Type(), 4), global, indices, 2, "fmt_ptr")
}

pub fn llvm_new(): LlvmBuilder
{
    vix_reset_vars()
    let module = LLVMModuleCreateWithName("vixc0")
    let builder = LLVMCreateBuilder()
    let printf_ty = vix_LLVMFunctionType1(LLVMInt32Type(), LLVMPointerType(LLVMInt8Type(), 0), 1)
    let printf_fn = vix_LLVMAddFunction(module, "printf", printf_ty)
    let malloc_ty = vix_LLVMFunctionType1(LLVMPointerType(LLVMInt8Type(), 0), LLVMInt64Type(), 0)
    let malloc_fn = vix_LLVMAddFunction(module, "malloc", malloc_ty)
    return LlvmBuilder{ module: module, builder: builder, current_fn: nil, current_block: nil, temp_counter: 0, label_counter: 0, printf_fn: printf_fn, malloc_fn: malloc_fn }
}

pub fn llvm_get_code(b: &LlvmBuilder): string
{
    return LLVMPrintModuleToString(b.module)
}

pub fn llvm_temp(b: &LlvmBuilder, prefix: string): string
{
    let val = b.temp_counter
    b.temp_counter = val + 1
    return prefix + i32_to_str(val)
}

pub fn llvm_label_name(b: &LlvmBuilder, prefix: string): string
{
    let val = b.label_counter
    b.label_counter = val + 1
    return prefix + i32_to_str(val)
}

pub fn llvm_emit_function_header(b: &LlvmBuilder, name: string, ret_ty: string)
{
    llvm_emit_function_header_with_params(b, name, ret_ty, [], [])
}

pub fn llvm_emit_function_header_with_params(b: &LlvmBuilder, name: string, ret_ty: string, param_names: [string], param_types: [string])
{
    vix_reset_vars()
    let llvm_ret_ty = if (ret_ty == "void") { LLVMVoidType() } else { LLVMInt32Type() }
    let fn_ty = vix_LLVMFunctionTypeI32N(llvm_ret_ty, param_names.length, 0)
    let mut fn_ref = vix_LLVMGetNamedFunction(b.module, name)
    if (fn_ref == nil)
    {
        fn_ref = vix_LLVMAddFunction(b.module, name, fn_ty)
    }
    b.current_fn = fn_ref
    let entry = vix_LLVMAppendBasicBlock(b.current_fn, "entry")
    vix_LLVMPositionBuilderAtEnd(b.builder, entry)
    b.current_block = entry
    for (i in 0 .. param_names.length)
    {
        let param_value = vix_LLVMGetParam(b.current_fn, i)
        let alloca = llvm_alloc_i32_var(b, param_names[i])
        vix_LLVMBuildStore(b.builder, param_value, alloca)
    }
}

pub fn llvm_emit_end_function(b: &LlvmBuilder)
{
    b.current_fn = nil
    b.current_block = nil
}

pub fn llvm_emit_label(b: &LlvmBuilder, name: string)
{
    let block = llvm_append_block(b, name)
    llvm_position_at_end(b, block)
}

pub fn llvm_append_block(b: &LlvmBuilder, name: string): ptr
{
    return vix_LLVMAppendBasicBlock(b.current_fn, name)
}

pub fn llvm_position_at_end(b: &LlvmBuilder, block: ptr)
{
    vix_LLVMPositionBuilderAtEnd(b.builder, block)
    b.current_block = block
}

pub fn llvm_emit_ret_void(b: &LlvmBuilder)
{
    vix_LLVMBuildRetVoid(b.builder)
}

pub fn llvm_current_block_terminated(b: &LlvmBuilder): i32
{
    if (b.current_block == nil) { return 1 }
    if (vix_LLVMGetBasicBlockTerminator(b.current_block) != nil) { return 1 }
    return 0
}

pub fn llvm_const_i32(value: i32): ptr
{
    return vix_LLVMConstInt(LLVMInt32Type(), i32_to_i64(value), 0)
}

pub fn llvm_alloc_i32_var(b: &LlvmBuilder, name: string): ptr
{
    let alloca = vix_LLVMBuildAlloca(b.builder, LLVMInt32Type(), name)
    set_var(b, name, alloca)
    return alloca
}

pub fn llvm_load_i32_var(b: &LlvmBuilder, name: string): ptr
{
    return vix_LLVMBuildLoad2(b.builder, LLVMInt32Type(), get_var(b, name), llvm_temp(b, "load"))
}

pub fn llvm_store_value(b: &LlvmBuilder, value: ptr, target_name: string)
{
    vix_LLVMBuildStore(b.builder, value, get_var(b, target_name))
}

pub fn llvm_define_i32_var(b: &LlvmBuilder, name: string, value: ptr)
{
    let alloca = llvm_alloc_i32_var(b, name)
    vix_LLVMBuildStore(b.builder, value, alloca)
}

pub fn llvm_build_add_value(b: &LlvmBuilder, left: ptr, right: ptr): ptr
{
    return vix_LLVMBuildAdd(b.builder, left, right, llvm_temp(b, "add"))
}

pub fn llvm_build_sub_value(b: &LlvmBuilder, left: ptr, right: ptr): ptr
{
    return vix_LLVMBuildSub(b.builder, left, right, llvm_temp(b, "sub"))
}

pub fn llvm_build_mul_value(b: &LlvmBuilder, left: ptr, right: ptr): ptr
{
    return vix_LLVMBuildMul(b.builder, left, right, llvm_temp(b, "mul"))
}

pub fn llvm_build_div_value(b: &LlvmBuilder, left: ptr, right: ptr): ptr
{
    return vix_LLVMBuildSDiv(b.builder, left, right, llvm_temp(b, "div"))
}

pub fn llvm_build_mod_value(b: &LlvmBuilder, left: ptr, right: ptr): ptr
{
    return vix_LLVMBuildSRem(b.builder, left, right, llvm_temp(b, "mod"))
}

pub fn llvm_build_neg_value(b: &LlvmBuilder, value: ptr): ptr
{
    return vix_LLVMBuildNeg(b.builder, value, llvm_temp(b, "neg"))
}

pub fn llvm_build_icmp_value(b: &LlvmBuilder, op: i32, left: ptr, right: ptr): ptr
{
    let cmp = vix_LLVMBuildICmp(b.builder, op, left, right, llvm_temp(b, "cmp"))
    return vix_LLVMBuildZExt(b.builder, cmp, LLVMInt32Type(), llvm_temp(b, "bool"))
}

pub fn llvm_build_truthy_i1(b: &LlvmBuilder, value: ptr): ptr
{
    return vix_LLVMBuildICmp(b.builder, 33, value, llvm_const_i32(0), llvm_temp(b, "cond"))
}

pub fn llvm_build_not_value(b: &LlvmBuilder, value: ptr): ptr
{
    return llvm_build_icmp_value(b, 32, value, llvm_const_i32(0))
}

pub fn llvm_emit_ret_value(b: &LlvmBuilder, value: ptr)
{
    vix_LLVMBuildRet(b.builder, value)
}

pub fn llvm_emit_jnz_value(b: &LlvmBuilder, cond_value: ptr, then_label: string, else_label: string)
{
    let cond = llvm_build_truthy_i1(b, cond_value)
    let then_block = vix_LLVMAppendBasicBlock(b.current_fn, then_label)
    let else_block = vix_LLVMAppendBasicBlock(b.current_fn, else_label)
    vix_LLVMBuildCondBr(b.builder, cond, then_block, else_block)
}

pub fn llvm_emit_condbr_blocks(b: &LlvmBuilder, cond_value: ptr, then_block: ptr, else_block: ptr)
{
    let cond = llvm_build_truthy_i1(b, cond_value)
    vix_LLVMBuildCondBr(b.builder, cond, then_block, else_block)
}

pub fn llvm_build_call_value(b: &LlvmBuilder, func: string, args: [ptr]): ptr
{
    let mut fn_ref = vix_LLVMGetNamedFunction(b.module, func)
    let fn_ty = vix_LLVMFunctionTypeI32N(LLVMInt32Type(), args.length, 0)
    if (fn_ref == nil)
    {
        fn_ref = vix_LLVMAddFunction(b.module, func, fn_ty)
    }
    return vix_LLVMBuildCall2(b.builder, fn_ty, fn_ref, args, args.length, llvm_temp(b, "call"))
}

pub fn llvm_emit_printf_i32_value(b: &LlvmBuilder, value: ptr)
{
    let fmt_ptr = get_fmt_string(b)
    let args = [fmt_ptr, value]
    let _ = vix_LLVMBuildCall2(b.builder, vix_LLVMFunctionType1(LLVMInt32Type(), LLVMPointerType(LLVMInt8Type(), 0), 1), b.printf_fn, args, 2, "")
}

pub fn llvm_build_eq_string_value(b: &LlvmBuilder, left: string, right_literal: string): ptr
{
    if (left == right_literal)
    {
        return llvm_const_i32(1)
    }
    return llvm_build_icmp_value(b, 32, llvm_const_i32(0), llvm_const_i32(0))
}

pub fn llvm_emit_jmp(b: &LlvmBuilder, label: string)
{
    let block = vix_LLVMAppendBasicBlock(b.current_fn, label)
    vix_LLVMBuildBr(b.builder, block)
}

pub fn llvm_emit_jmp_block(b: &LlvmBuilder, block: ptr)
{
    vix_LLVMBuildBr(b.builder, block)
}
