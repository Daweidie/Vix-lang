{
    qbe_push_instr(b, QbeInstr{ tag: "loadw", result: result, ty: "", func: "", op: "", left: "", right: "", value: source, label: "", then_label: "", else_label: "", comment: "", args: [], int_value: 0 })
}

pub fn qbe_emit_comment(b: &QbeBuilder, text: string)
{
    qbe_push_instr(b, QbeInstr{ tag: "comment", result: "", ty: "", func: "", op: "", left: "", right: "", value: "", label: "", then_label: "", else_label: "", comment: text, args: [], int_value: 0 })
}

pub fn qbe_emit_call_typed(b: &QbeBuilder, result_ty: string, result: string, func: string, args: [QbeCallArg])
{
    qbe_push_instr(b, QbeInstr{ tag: "call", result: result, ty: result_ty, func: func, op: "", left: "", right: "", value: "", label: "", then_label: "", else_label: "", comment: "", args: args, int_value: 0 })
}

pub fn qbe_emit_call(b: &QbeBuilder, result: string, func: string, args: [string])
{
    qbe_emit_call_typed(b, "w", result, func, qbe_push_call_args_from_strings(args))
}

pub fn qbe_emit_call_void(b: &QbeBuilder, func: string, args: [string])
{
    qbe_emit_call_typed(b, "", "", func, qbe_push_call_args_from_strings(args))
}

pub fn qbe_emit_printf_i32(b: &QbeBuilder, value: string)
{
    qbe_emit_call_typed(b, "", "", "printf", [QbeCallArg{ ty: "l", value: "$str_fmt" }, QbeCallArg{ ty: "w", value: value }])
}

pub fn qbe_emit_call_ptr(b: &QbeBuilder, result: string, func: string, args: [string])
{
    let mut typed_args: [QbeCallArg] = []
    for (i in 0 .. args.length)
    {
        typed_args.push(QbeCallArg{ ty: "l", value: args[i] })
    }
    qbe_emit_call_typed(b, "l", result, func, typed_args)
}

pub fn qbe_emit_eq_string(b: &QbeBuilder, result: string, left: string, right_literal: string)
{
    qbe_push_instr(b, QbeInstr{ tag: "eq_string", result: result, ty: "", func: "", op: "", left: left, right: right_literal, value: "", label: "", then_label: "", else_label: "", comment: "", args: [], int_value: 0 })
}

pub fn qbe_render(b: &QbeBuilder): string
{
    let mut out = ""
    for (i in 0 .. b.data_defs.length)
    {
        let item = b.data_defs[i]
        out = out + "data $str_" + item.label + " = { b \"" + item.value + "\", b 0 }\n"
    }
    for (i in 0 .. b.instrs.length)
    {
        let instr = b.instrs[i]
        if (instr.tag == "function_header")
        {
            if (instr.ty == "void")
            {
                out = out + "export function $" + instr.func + "()\n{\n"
            }
            else
            {
                out = out + "export function w $" + instr.func + "()\n{\n"
            }
        }
        else if (instr.tag == "function_end")
        {
            out = out + "}\n"
        }
        else if (instr.tag == "label")
        {
            out = out + "@" + instr.label + "\n"
        }
        else if (instr.tag == "ret_i32")
        {
            out = out + "\tret " + instr.value + "\n"
        }
        else if (instr.tag == "ret_void")
        {
            out = out + "\tret\n"
        }
        else if (instr.tag == "copy")
        {
            out = out + "\t" + instr.result + " =w copy " + instr.value + "\n"
        }
        else if (instr.tag == "copy_i32")
        {
            out = out + "\t" + instr.result + " =w copy " + i32_to_str(instr.int_value) + "\n"
        }
        else if (instr.tag == "binary")
        {
            out = out + "\t" + instr.result + " =w " + instr.op + " " + instr.left + ", " + instr.right + "\n"
        }
        else if (instr.tag == "neg")
        {
            out = out + "\t" + instr.result + " =w sub 0, " + instr.left + "\n"
        }
        else if (instr.tag == "jnz")
        {
            out = out + "\tjnz " + instr.value + ", @" + instr.then_label + ", @" + instr.else_label + "\n"
        }
        else if (instr.tag == "jmp")
        {
            out = out + "\tjmp @" + instr.label + "\n"
        }
        else if (instr.tag == "alloc4")
        {
            out = out + "\t" + instr.result + " =w alloc4 4\n"
        }
        else if (instr.tag == "storew")
        {
            out = out + "\tstorew " + instr.left + ", " + instr.right + "\n"
        }
        else if (instr.tag == "loadw")
        {
            out = out + "\t" + instr.result + " =w loadw %" + instr.value + "\n"
        }
        else if (instr.tag == "comment")
        {
            out = out + "\t# " + instr.comment + "\n"
        }
        else if (instr.tag == "eq_string")
        {
            out = out + "\t" + instr.result + " =w call $vix_str_eq(l %" + instr.left + ", l $str_" + instr.right + ")\n"
        }
        else if (instr.tag == "call")
        {
            let mut call_args = ""
            for (j in 0 .. instr.args.length)
            {
                if (j > 0) { call_args = call_args + ", " }
                let call_arg = instr.args[j]
                call_args = call_args + call_arg.ty + " " + call_arg.value
            }
            if (instr.result == "")
            {
                out = out + "\tcall $" + instr.func + "(" + call_args + ")\n"
            }
            else
            {
                out = out + "\t" + instr.result + " =" + instr.ty + " call $" + instr.func + "(" + call_args + ")\n"
            }
        }
    }
    return out
}
