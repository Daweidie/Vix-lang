#[no_main]
import "ast.vix"
import "ir-builder.vix"

pub fn codegen_expr(expr: AstExpr): string
{
    if (expr.tag == "int") { return qbe_i32(expr.int_value) }
    if (expr.tag == "bool") { return qbe_i32(expr.int_value) }
    if (expr.tag == "ident") { return "%" + expr.text }
    if (expr.tag == "string") { return "$str_" + expr.text }
    if (expr.tag == "binop") { return "(" + expr.left + " " + expr.text + " " + expr.right + ")" }
    if (expr.tag == "unaryop") { return "(" + expr.text + expr.left + ")" }
    if (expr.tag == "call")
    {
        let mut call_str = "$" + expr.text + "("
        for (i in 0 .. expr.args.length)
        {
            if (i > 0) { call_str = call_str + ", " }
            call_str = call_str + "w " + expr.args[i]
        }
        call_str = call_str + ")"
        return call_str
    }
    if (expr.tag == "option")
    {
        if (expr.option_has_value == 1) { return expr.option_value }
        return "0"
    }
    return "0"
}

pub fn codegen_stmt(stmt: AstStmt, store: StmtStore): string
{
    if (stmt.tag == "return")
    {
        return qbe_ret_i32(qbe_i32(stmt.direct_ret))
    }
    if (stmt.tag == "return_expr")
    {
        return qbe_ret_i32(codegen_expr(stmt.value_expr))
    }
    if (stmt.tag == "let")
    {
        let val = codegen_expr(stmt.assign_expr)
        return "\t%" + stmt.assign_name + " =w copy " + val + "\n"
    }
    if (stmt.tag == "assign")
    {
        let val = codegen_expr(stmt.assign_expr)
        return "\t%" + stmt.assign_name + " =w copy " + val + "\n"
    }
    if (stmt.tag == "print")
    {
        let val = codegen_expr(stmt.print_expr)
        return "\tcall $printf(l $str_fmt, w " + val + ")\n"
    }
    if (stmt.tag == "expr")
    {
        let val = codegen_expr(stmt.value_expr)
        return "\t" + val + "\n"
    }
    if (stmt.tag == "if_eq_return")
    {
        let mut code = ""
        code = code + qbe_label("start")
        code = code + qbe_eq_string("%cmp", stmt.cond_left, stmt.cond_right)
        code = code + qbe_jnz("%cmp", "then", "else")
        code = code + qbe_label("then")
        code = code + qbe_ret_i32(qbe_i32(stmt.then_ret))
        code = code + qbe_label("else")
        code = code + qbe_ret_i32(qbe_i32(stmt.else_ret))
        return code
    }
    if (stmt.tag == "match_option_string")
    {
        let mut code = ""
        code = code + qbe_label("start")
        code = code + qbe_copy_i32("%has", ast_expr_option_has_value(stmt.value_expr))
        code = code + qbe_jnz("%has", "some", "none")
        code = code + qbe_label("some")
        code = code + "\t# bound string value available as %" + stmt.match_bind + "\n"
        code = code + qbe_eq_string("%strcmp_res", stmt.match_bind, stmt.match_compare_right)
        code = code + qbe_jnz("%strcmp_res", "then", "else")
        code = code + qbe_label("then")
        code = code + qbe_ret_i32(qbe_i32(stmt.match_some_then_ret))
        code = code + qbe_label("else")
        code = code + qbe_ret_i32(qbe_i32(stmt.match_some_else_ret))
        code = code + qbe_label("none")
        code = code + qbe_ret_i32(qbe_i32(stmt.match_none_ret))
        return code
    }
    if (stmt.tag == "block")
    {
        let mut code = ""
        for (i in 0 .. stmt.block_count)
        {
            code = code + codegen_stmt(stmt_store_get(store, stmt.block_start + i), store)
        }
        return code
    }
    return ""
}

pub fn codegen_program(program: AstProgram): string
{
    if (program.ok == 0)
    {
        return program.error
    }
    let mut output = ""
    output = output + qbe_data_string("fmt", "%d\\n")
    output = output + qbe_function_header(program.function.name, program.function.ret_ty)
    output = output + codegen_stmt(program.function.body, program.store)
    if (program.function.ret_ty == "void")
    {
        output = output + qbe_ret_void()
    }
    else
    {
        output = output + qbe_ret_i32("0")
    }
    output = output + qbe_end_function()
    return output
}
