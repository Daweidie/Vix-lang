import "lexer.vix"
import "parser.vix"
import "ast.vix"
import "codegen.vix"

fn main(argc: i32, argv: ptr): i32
{
    let mut src = "fn main():i32 { return 0 }"
    let mut mode = "codegen"

    if (argc > 1)
    {
        mode = argv[1]
    }
    if (argc > 2)
    {
        src = argv[2]
    }

    if (mode == "--lex")
    {
        print(tokenize_debug(src))
        return 0
    }

    let program = parse_program(src)

    if (mode == "--parser" or mode == "--ast")
    {
        print(ast_program_debug(program))
        return 0
    }

    let qbe = codegen_program(program)
    print(qbe)
    return 0
}