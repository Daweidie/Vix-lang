let TY_UNKNOWN = 0
let TY_I32 = 1
let TY_F64 = 2
let TY_BOOL = 3
let TY_STRING = 4

pub type LiteralClass = LitString
                      | LitBool
                      | LitFloat
                      | LitI32

pub type BinaryClass = BinUnknown
                    | BinString
                    | BinBool
                    | BinFloat
                    | BinI32

pub fn ti_is_float_literal(src: string, start0: i32, end0: i32) -> i32
{
    let i0 = start0
    while (i0 < end0)
    {
        if (src[i0] == '.')
        {
            return 1
        }
        i0 += 1
    }
    return 0
}

pub fn ti_is_true(src: string, start0: i32, end0: i32) -> i32
{
    if (end0 - start0 != 4)
    {
        return 0
    }
    if (src[start0] == 't' and src[start0 + 1] == 'r' and src[start0 + 2] == 'u' and src[start0 + 3] == 'e')
    {
        return 1
    }
    return 0
}

pub fn ti_is_false(src: string, start0: i32, end0: i32) -> i32
{
    if (end0 - start0 != 5)
    {
        return 0
    }
    if (src[start0] == 'f' and src[start0 + 1] == 'a' and src[start0 + 2] == 'l' and src[start0 + 3] == 's' and src[start0 + 4] == 'e')
    {
        return 1
    }
    return 0
}

pub fn ti_infer_literal(src: string, start0: i32, end0: i32, kind: i32) -> i32
{
    let cls0 = LitI32
    if (kind == 4)
    {
        cls0 = LitString
    }
    elif (ti_is_true(src, start0, end0) == 1 or ti_is_false(src, start0, end0) == 1)
    {
        cls0 = LitBool
    }
    elif (ti_is_float_literal(src, start0, end0) == 1)
    {
        cls0 = LitFloat
    }

    match cls0
    {
        LitString -> return 4
        LitBool -> return 3
        LitFloat -> return 2
        LitI32 -> return 1
    }
}

pub fn ti_infer_binary(lhs_ty: i32, rhs_ty: i32, op: i32) -> i32
{
    let cls0 = BinI32
    if (lhs_ty == 0 or rhs_ty == 0)
    {
        cls0 = BinUnknown
    }
    elif (lhs_ty == 4 or rhs_ty == 4)
    {
        cls0 = BinString
    }
    elif (lhs_ty == 3 or rhs_ty == 3)
    {
        cls0 = BinBool
    }
    elif (lhs_ty == 2 or rhs_ty == 2)
    {
        cls0 = BinFloat
    }

    match cls0
    {
        BinUnknown -> return 0
        BinBool -> return 0
        BinFloat -> return 2
        BinI32 -> return 1
        BinString -> {
            if (op == '+' and lhs_ty == 4 and rhs_ty == 4)
            {
                return 4
            }
            return 0
        }
    }
}

pub fn ti_type_name(ty: i32) -> string
{
    match ty
    {
        1 -> return "i32"
        2 -> return "f64"
        3 -> return "bool"
        4 -> return "string"
        _ -> return "unknown"
    }
}
