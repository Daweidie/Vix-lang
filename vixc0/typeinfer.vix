#[no_main]
import "ast.vix"
import "symtable.vix"

pub type FunctionSymbols = struct {
    names: [string],
    return_types: [string],
    arg_counts: [i32],
    is_var_args: [i32],
    ok: i32,
    error: string
}

pub type StructSymbols = struct {
    names: [string],
    field_names: [string],
    field_types: [string],
    field_structs: [string],
    ok: i32,
    error: string
}

pub type TypeInferResult = struct {
    ok: i32,
    error: string,
    return_type: string
}

pub fn function_symbols_new(): FunctionSymbols
{
    return FunctionSymbols{ names: [], return_types: [], arg_counts: [], is_var_args: [], ok: 1, error: "" }
}

pub fn struct_symbols_new(): StructSymbols
{
    return StructSymbols{ names: [], field_names: [], field_types: [], field_structs: [], ok: 1, error: "" }
}

pub fn struct_symbols_fail(symbols: &StructSymbols, message: string)
{
    if (symbols.ok == 1)
    {
        symbols.ok = 0
        symbols.error = message
    }
}

pub fn struct_symbols_find(symbols: &StructSymbols, name: string): i32
{
    for (i in 0 .. symbols.names.length)
    {
        if (symbols.names[i] == name) { return i }
    }
    return -1
}

pub fn struct_symbols_declare(symbols: &StructSymbols, decl: AstStructDecl)
{
    if (struct_symbols_find(symbols, decl.name) >= 0)
    {
        struct_symbols_fail(symbols, "duplicate struct '" + decl.name + "'")
        return
    }
    symbols.names.push(decl.name)
    for (i in 0 .. decl.field_names.length)
    {
        symbols.field_structs.push(decl.name)
        symbols.field_names.push(decl.field_names[i])
        symbols.field_types.push(decl.field_types[i])
    }
}

pub fn struct_symbols_field_type(symbols: &StructSymbols, struct_name: string, field_name: string): string
{
    if (struct_symbols_find(symbols, struct_name) < 0)
    {
        struct_symbols_fail(symbols, "unknown struct '" + struct_name + "'")
        return "unknown"
    }
    for (i in 0 .. symbols.field_names.length)
    {
        if (symbols.field_structs[i] == struct_name and symbols.field_names[i] == field_name)
        {
            return symbols.field_types[i]
        }
    }
    struct_symbols_fail(symbols, "unknown field '" + field_name + "' on struct '" + struct_name + "'")
    return "unknown"
}

pub fn function_symbols_fail(symbols: &FunctionSymbols, message: string)
{
    if (symbols.ok == 1)
    {
        symbols.ok = 0
        symbols.error = message
    }
}

pub fn function_symbols_find(symbols: &FunctionSymbols, name: string): i32
{
    for (i in 0 .. symbols.names.length)
    {
        if (symbols.names[i] == name) { return i }
    }
    return -1
}

pub fn function_symbols_declare(symbols: &FunctionSymbols, name: string, ret_ty: string, arg_count: i32)
{
    function_symbols_declare_vararg(symbols, name, ret_ty, arg_count, 0)
}

pub fn function_symbols_declare_vararg(symbols: &FunctionSymbols, name: string, ret_ty: string, arg_count: i32, is_var_arg: i32)
{
    let idx = function_symbols_find(symbols, name)
    if (idx >= 0)
    {
        function_symbols_fail(symbols, "duplicate function '" + name + "'")
        return
    }
    symbols.names.push(name)
    symbols.return_types.push(ret_ty)
    symbols.arg_counts.push(arg_count)
    symbols.is_var_args.push(is_var_arg)
}

pub fn function_symbols_return_type(symbols: &FunctionSymbols, name: string): string
{
    let idx = function_symbols_find(symbols, name)
    if (idx >= 0) { return symbols.return_types[idx] }
    function_symbols_fail(symbols, "undefined function '" + name + "'")
    return "unknown"
}

pub fn function_symbols_arg_count(symbols: &FunctionSymbols, name: string): i32
{
    let idx = function_symbols_find(symbols, name)
    if (idx >= 0) { return symbols.arg_counts[idx] }
    function_symbols_fail(symbols, "undefined function '" + name + "'")
    return 0
}

pub fn function_symbols_is_var_arg(symbols: &FunctionSymbols, name: string): i32
{
    let idx = function_symbols_find(symbols, name)
    if (idx >= 0) { return symbols.is_var_args[idx] }
    function_symbols_fail(symbols, "undefined function '" + name + "'")
    return 0
}

pub fn type_is_truthy(ty: string): i32
{
    if (ty == "bool" or ty == "i32" or ty == "unknown") { return 1 }
    return 0
}

pub fn type_is_integer(ty: string): i32
{
    if (ty == "i32" or ty == "i64" or ty == "unknown") { return 1 }
    return 0
}

pub fn type_is_float(ty: string): i32
{
    if (ty == "f32" or ty == "f64" or ty == "unknown") { return 1 }
    return 0
}

pub fn type_is_numeric(ty: string): i32
{
    if (type_is_integer(ty) == 1 or type_is_float(ty) == 1) { return 1 }
    return 0
}

pub fn type_numeric_result(left_ty: string, right_ty: string): string
{
    if (left_ty == "unknown") { return right_ty }
    if (right_ty == "unknown") { return left_ty }
    if (left_ty == "f64" or right_ty == "f64") { return "f64" }
    if (left_ty == "f32" or right_ty == "f32") { return "f32" }
    if (left_ty == "i64" or right_ty == "i64") { return "i64" }
    return "i32"
}

pub fn type_can_assign(target_ty: string, value_ty: string): i32
{
    if (target_ty == "" or target_ty == "unknown" or value_ty == "unknown") { return 1 }
    if (target_ty == value_ty) { return 1 }
    if (target_ty == "i64" and value_ty == "i32") { return 1 }
    if ((target_ty == "f32" or target_ty == "f64") and (value_ty == "i32" or value_ty == "i64" or value_ty == "f32" or value_ty == "f64")) { return 1 }
    return 0
}

pub fn infer_expr_type(env: &SymbolTable, funcs: &FunctionSymbols, structs: &StructSymbols, es: &ExprStore, idx: i32): string
{
    if (idx < 0) { return "unknown" }
    let expr = expr_store_get(es, idx)
    return match expr.tag
    {
        "int" -> "i32"
        "bool" -> "bool"
        "float" -> "f64"
        "string" -> "string"
        "ident" -> symtable_lookup(env, expr.text)
        "option" -> "Option[string]"
        "addr" -> {
            let _ = symtable_lookup(env, expr.text)
            if (env.ok == 0) { return "unknown" }
            "ptr"
        }
        "deref" -> {
            let ptr_ty = infer_expr_type(env, funcs, structs, es, expr.left_idx)
            if (env.ok == 0) { return "unknown" }
            if (ptr_ty != "ptr" and ptr_ty != "unknown")
            {
                symtable_fail(env, "cannot dereference value of type '" + ptr_ty + "'")
                return "unknown"
            }
            "i32"
        }
        "field" -> {
            let base_ty = infer_expr_type(env, funcs, structs, es, expr.left_idx)
            if (env.ok == 0) { return "unknown" }
            let field_ty = struct_symbols_field_type(structs, base_ty, expr.text)
            if (structs.ok == 0)
            {
                symtable_fail(env, structs.error)
                return "unknown"
            }
            field_ty
        }
        "struct_literal" -> {
            if (struct_symbols_find(structs, expr.text) < 0)
            {
                symtable_fail(env, "unknown struct '" + expr.text + "'")
                return "unknown"
            }
            for (i in 0 .. expr.args.length)
            {
                let field_name = expr.field_names[i]
                let expected_ty = struct_symbols_field_type(structs, expr.text, field_name)
                if (structs.ok == 0)
                {
                    symtable_fail(env, structs.error)
                    return "unknown"
                }
                let actual_ty = infer_expr_type(env, funcs, structs, es, expr.args[i])
                if (env.ok == 0) { return "unknown" }
                if (type_can_assign(expected_ty, actual_ty) == 0)
                {
                    symtable_fail(env, "cannot initialize field '" + field_name + "' of struct '" + expr.text + "' with '" + actual_ty + "'")
                    return "unknown"
                }
            }
            expr.text
        }
        "call" -> {
            let expected_args = function_symbols_arg_count(funcs, expr.text)
            let is_var_arg = function_symbols_is_var_arg(funcs, expr.text)
            if (funcs.ok == 0)
            {
                symtable_fail(env, funcs.error)
                return "unknown"
            }
            if ((is_var_arg == 0 and expected_args != expr.args.length) or (is_var_arg == 1 and expr.args.length < expected_args))
            {
                symtable_fail(env, "function '" + expr.text + "' expects " + ast_i32(expected_args) + " arguments, got " + ast_i32(expr.args.length))
                return "unknown"
            }
            for (i in 0 .. expr.args.length)
            {
                let _ = infer_expr_type(env, funcs, structs, es, expr.args[i])
                if (env.ok == 0) { return "unknown" }
            }
            function_symbols_return_type(funcs, expr.text)
        }
        "index" -> {
            let base_ty = infer_expr_type(env, funcs, structs, es, expr.left_idx)
            if (env.ok == 0) { return "unknown" }
            let index_ty = infer_expr_type(env, funcs, structs, es, expr.right_idx)
            if (env.ok == 0) { return "unknown" }
            if (type_is_integer(index_ty) == 0)
            {
                symtable_fail(env, "index expression expects integer index, got '" + index_ty + "'")
                return "unknown"
            }
            if (base_ty == "ptr" or base_ty == "unknown")
            {
                return "string"
            }
            symtable_fail(env, "cannot index value of type '" + base_ty + "'")
            "unknown"
        }
        "unaryop" -> {
            let inner_ty = infer_expr_type(env, funcs, structs, es, expr.left_idx)
            if (env.ok == 0) { return "unknown" }
            if (expr.text == "-")
            {
                if (type_is_numeric(inner_ty) == 0)
                {
                    symtable_fail(env, "operator '-' expects numeric operand, got '" + inner_ty + "'")
                }
                inner_ty
            }
            elif (expr.text == "!")
            {
                if (type_is_truthy(inner_ty) == 0)
                {
                    symtable_fail(env, "operator '!' expects bool or i32 operand, got '" + inner_ty + "'")
                }
                "bool"
            }
            else
            {
                "unknown"
            }
        }
        "binop" -> {
            let left_ty = infer_expr_type(env, funcs, structs, es, expr.left_idx)
            if (env.ok == 0) { return "unknown" }
            let right_ty = infer_expr_type(env, funcs, structs, es, expr.right_idx)
            if (env.ok == 0) { return "unknown" }
            if (expr.text == "==" or expr.text == "!=" or expr.text == "<" or expr.text == "<=" or expr.text == ">" or expr.text == ">=")
            {
                if (left_ty != right_ty and left_ty != "unknown" and right_ty != "unknown" and (type_is_numeric(left_ty) == 0 or type_is_numeric(right_ty) == 0))
                {
                    symtable_fail(env, "cannot compare '" + left_ty + "' with '" + right_ty + "'")
                }
                "bool"
            }
            elif (expr.text == "and" or expr.text == "or")
            {
                if (type_is_truthy(left_ty) == 0)
                {
                    symtable_fail(env, "operator '" + expr.text + "' expects bool or i32 left operand, got '" + left_ty + "'")
                }
                if (type_is_truthy(right_ty) == 0)
                {
                    symtable_fail(env, "operator '" + expr.text + "' expects bool or i32 right operand, got '" + right_ty + "'")
                }
                "bool"
            }
            elif (expr.text == "+")
            {
                if (left_ty == "string" or right_ty == "string")
                {
                    if (left_ty != "string" or right_ty != "string")
                    {
                        symtable_fail(env, "operator '+' cannot mix '" + left_ty + "' and '" + right_ty + "'")
                    }
                    "string"
                }
                else
                {
                    if (type_is_numeric(left_ty) == 0 or type_is_numeric(right_ty) == 0)
                    {
                        symtable_fail(env, "operator '+' expects numeric operands")
                    }
                    type_numeric_result(left_ty, right_ty)
                }
            }
            else
            {
                if (type_is_numeric(left_ty) == 0 or type_is_numeric(right_ty) == 0)
                {
                    symtable_fail(env, "operator '" + expr.text + "' expects numeric operands")
                }
                type_numeric_result(left_ty, right_ty)
            }
        }
        _ -> "unknown"
    }
}

pub fn infer_stmt_type_in_loop(env: &SymbolTable, funcs: &FunctionSymbols, structs: &StructSymbols, es: &ExprStore, store: &StmtStore, stmt_idx: i32, ret_ty: string, loop_depth: i32)
{
    if (stmt_idx < 0 or env.ok == 0) { return }
    let stmt = stmt_store_get(store, stmt_idx)
    match stmt.tag
    {
        "let" -> {
            let mut ty = infer_expr_type(env, funcs, structs, es, stmt.assign_idx)
            if (env.ok == 0) { return }
            if (stmt.type_text != "")
            {
                if (type_can_assign(stmt.type_text, ty) == 0)
                {
                    symtable_fail(env, "cannot initialize '" + stmt.assign_name + "' of type '" + stmt.type_text + "' with '" + ty + "'")
                    return
                }
                ty = stmt.type_text
            }
            symtable_declare_mut(env, stmt.assign_name, ty, stmt.is_mut)
        }
        "assign" -> {
            let current_ty = symtable_lookup(env, stmt.assign_name)
            if (env.ok == 0) { return }
            if (symtable_is_mutable(env, stmt.assign_name) == 0)
            {
                symtable_fail(env, "cannot assign to immutable binding '" + stmt.assign_name + "'")
                return
            }
            let value_ty = infer_expr_type(env, funcs, structs, es, stmt.assign_idx)
            if (env.ok == 0) { return }
            if (type_can_assign(current_ty, value_ty) == 0)
            {
                symtable_fail(env, "cannot assign '" + value_ty + "' to '" + stmt.assign_name + "' of type '" + current_ty + "'")
            }
        }
        "store_deref" -> {
            let ptr_ty = infer_expr_type(env, funcs, structs, es, stmt.value_idx)
            if (env.ok == 0) { return }
            if (ptr_ty != "ptr" and ptr_ty != "unknown")
            {
                symtable_fail(env, "cannot store through value of type '" + ptr_ty + "'")
                return
            }
            let value_ty = infer_expr_type(env, funcs, structs, es, stmt.assign_idx)
            if (env.ok == 0) { return }
            if (type_can_assign("i32", value_ty) == 0)
            {
                symtable_fail(env, "cannot store '" + value_ty + "' through i32 pointer")
            }
        }
        "return" -> {
            if (ret_ty != "i32" and ret_ty != "unknown")
            {
                symtable_fail(env, "return value type 'i32' does not match function return type '" + ret_ty + "'")
            }
        }
        "return_expr" -> {
            let value_ty = infer_expr_type(env, funcs, structs, es, stmt.value_idx)
            if (env.ok == 0) { return }
            if (ret_ty != "void" and ret_ty != "unknown" and value_ty != "unknown" and value_ty != ret_ty)
            {
                symtable_fail(env, "return value type '" + value_ty + "' does not match function return type '" + ret_ty + "'")
            }
        }
        "print" -> {
            let _ = infer_expr_type(env, funcs, structs, es, stmt.print_idx)
        }
        "expr" -> {
            let _ = infer_expr_type(env, funcs, structs, es, stmt.value_idx)
        }
        "block" -> {
            symtable_push_scope(env)
            if (stmt.stmt_indices.length > 0)
            {
                for (i in 0 .. stmt.stmt_indices.length)
                {
                    infer_stmt_type_in_loop(env, funcs, structs, es, store, stmt.stmt_indices[i], ret_ty, loop_depth)
                    if (env.ok == 0)
                    {
                        symtable_pop_scope(env)
                        return
                    }
                }
            }
            else
            {
                for (i in 0 .. stmt.block_count)
                {
                    infer_stmt_type_in_loop(env, funcs, structs, es, store, stmt.block_start + i, ret_ty, loop_depth)
                    if (env.ok == 0)
                    {
                        symtable_pop_scope(env)
                        return
                    }
                }
            }
            symtable_pop_scope(env)
        }
        "while" -> {
            let cond_ty = infer_expr_type(env, funcs, structs, es, stmt.value_idx)
            if (env.ok == 0) { return }
            if (type_is_truthy(cond_ty) == 0)
            {
                symtable_fail(env, "while condition must be bool or i32, got '" + cond_ty + "'")
                return
            }
            infer_stmt_type_in_loop(env, funcs, structs, es, store, stmt.body_idx, ret_ty, loop_depth + 1)
        }
        "for_range" -> {
            if (symtable_lookup_index(env, stmt.assign_name) >= 0)
            {
                symtable_fail(env, "for iterator '" + stmt.assign_name + "' conflicts with existing symbol")
                return
            }
            let start_ty = infer_expr_type(env, funcs, structs, es, stmt.value_idx)
            if (env.ok == 0) { return }
            let end_ty = infer_expr_type(env, funcs, structs, es, stmt.assign_idx)
            if (env.ok == 0) { return }
            if (type_is_integer(start_ty) == 0)
            {
                symtable_fail(env, "for range start must be integer, got '" + start_ty + "'")
                return
            }
            if (type_is_integer(end_ty) == 0)
            {
                symtable_fail(env, "for range end must be integer, got '" + end_ty + "'")
                return
            }
            symtable_push_scope(env)
            symtable_declare_mut(env, stmt.assign_name, "i32", 1)
            if (env.ok == 0)
            {
                symtable_pop_scope(env)
                return
            }
            infer_stmt_type_in_loop(env, funcs, structs, es, store, stmt.body_idx, ret_ty, loop_depth + 1)
            symtable_pop_scope(env)
        }
        "break" | "continue" -> {
            if (loop_depth <= 0)
            {
                symtable_fail(env, "'" + stmt.tag + "' used outside loop")
            }
        }
        "if" -> {
            let cond_ty = infer_expr_type(env, funcs, structs, es, stmt.value_idx)
            if (env.ok == 0) { return }
            if (type_is_truthy(cond_ty) == 0)
            {
                symtable_fail(env, "if condition must be bool or i32, got '" + cond_ty + "'")
                return
            }
            infer_stmt_type_in_loop(env, funcs, structs, es, store, stmt.body_idx, ret_ty, loop_depth)
            if (env.ok == 0) { return }
            if (stmt.assign_idx >= 0)
            {
                infer_stmt_type_in_loop(env, funcs, structs, es, store, stmt.assign_idx, ret_ty, loop_depth)
            }
        }
        "if_eq_return" -> {
            if (ret_ty != "i32" and ret_ty != "unknown")
            {
                symtable_fail(env, "if return value type 'i32' does not match function return type '" + ret_ty + "'")
            }
        }
        "match" -> {
            let subject_ty = infer_expr_type(env, funcs, structs, es, stmt.value_idx)
            if (env.ok == 0) { return }
            for (i in 0 .. stmt.match_pattern_indices.length)
            {
                let pattern_idx = stmt.match_pattern_indices[i]
                if (pattern_idx >= 0)
                {
                    let pattern_ty = infer_expr_type(env, funcs, structs, es, pattern_idx)
                    if (env.ok == 0) { return }
                    if (type_can_assign(subject_ty, pattern_ty) == 0 and type_can_assign(pattern_ty, subject_ty) == 0)
                    {
                        symtable_fail(env, "match pattern type '" + pattern_ty + "' does not match subject type '" + subject_ty + "'")
                        return
                    }
                }
                infer_stmt_type_in_loop(env, funcs, structs, es, store, stmt.match_body_indices[i], ret_ty, loop_depth)
                if (env.ok == 0) { return }
            }
        }
        "match_option_string" -> {
            if (ret_ty != "i32" and ret_ty != "unknown")
            {
                symtable_fail(env, "match return value type 'i32' does not match function return type '" + ret_ty + "'")
            }
        }
        _ -> {}
    }
}

pub fn infer_stmt_type(env: &SymbolTable, funcs: &FunctionSymbols, structs: &StructSymbols, es: &ExprStore, store: &StmtStore, stmt_idx: i32, ret_ty: string)
{
    infer_stmt_type_in_loop(env, funcs, structs, es, store, stmt_idx, ret_ty, 0)
}

pub fn infer_function(func: AstFunction, funcs: &FunctionSymbols, structs: &StructSymbols, es: &ExprStore, store: &StmtStore): TypeInferResult
{
    let env = symtable_new()
    for (i in 0 .. func.param_names.length)
    {
        symtable_declare(&env, func.param_names[i], func.param_types[i])
        if (env.ok == 0)
        {
            return TypeInferResult{ ok: 0, error: env.error, return_type: func.ret_ty }
        }
    }
    infer_stmt_type(&env, funcs, structs, es, store, func.body_idx, func.ret_ty)
    if (env.ok == 0)
    {
        return TypeInferResult{ ok: 0, error: env.error, return_type: func.ret_ty }
    }
    return TypeInferResult{ ok: 1, error: "", return_type: func.ret_ty }
}

pub fn infer(program: AstProgram): TypeInferResult
{
    if (program.ok == 0)
    {
        return TypeInferResult{ ok: 0, error: program.error, return_type: "unknown" }
    }
    let funcs = function_symbols_new()
    let structs = struct_symbols_new()
    for (i in 0 .. program.structs.length)
    {
        struct_symbols_declare(&structs, program.structs[i])
        if (structs.ok == 0)
        {
            return TypeInferResult{ ok: 0, error: structs.error, return_type: "unknown" }
        }
    }
    for (i in 0 .. program.extern_functions.length)
    {
        function_symbols_declare_vararg(&funcs, program.extern_functions[i].name, program.extern_functions[i].ret_ty, program.extern_functions[i].param_names.length, program.extern_functions[i].is_var_arg)
        if (funcs.ok == 0)
        {
            return TypeInferResult{ ok: 0, error: funcs.error, return_type: "unknown" }
        }
    }
    for (i in 0 .. program.functions.length)
    {
        function_symbols_declare(&funcs, program.functions[i].name, program.functions[i].ret_ty, program.functions[i].param_names.length)
        if (funcs.ok == 0)
        {
            return TypeInferResult{ ok: 0, error: funcs.error, return_type: "unknown" }
        }
    }
    let expr_store = program.expr_store
    let stmt_store = program.store
    for (i in 0 .. program.functions.length)
    {
        let result = infer_function(program.functions[i], &funcs, &structs, &expr_store, &stmt_store)
        if (result.ok == 0)
        {
            return result
        }
    }
    return TypeInferResult{ ok: 1, error: "", return_type: program.function.ret_ty }
}

pub fn typeinfer_result_debug(result: TypeInferResult): string
{
    if (result.ok == 0)
    {
        return "TypeError(" + result.error + ")"
    }
    return "TypeOk(return_type=" + result.return_type + ")"
}
