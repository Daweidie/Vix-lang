fn find_first_not_of(s: string, chars: string): i32
{
    for (i in 0 .. s.length)
    {
        if (!(s[i] in chars))
        {
            return i
        }
    }
    return -1
}

fn find_last_not_of(s: string, chars: string): i32
{
    for (i in (s.length - 1)..0)
    {
        if (!(s[i] in chars))
        {
            return i
        }
    }
    return -1
}

fn trim(s: string): string
{
    let start = s |> find_first_not_of(" ")
    let end = s |> find_last_not_of(" ")

    if (start == -1 or end == -1)
    {
        return ""
    }

    return s[start..end]
}

fn uppercase(s: string): string
{
    let result = ""

    for (c in s)
    {
        if (c >= 'a' and c <= 'z')
        {
            result += (c - 32)
        }
        else
        {
            result += c
        }
    }

    return result
}

fn split(s: string, delimiter: string): [string]
{
    let result = []
    let start = 0

    for (i in 0..s.length)
    {
        if (s[i] == delimiter)
        {
            result += s[start..i]
            start = i + 1
        }
    }

    result += s[start .. s.length]

    return result
}

fn main(): i32
{

    let result =
        "  hello vix  "
        |> trim
        |> uppercase
        |> split(" ")
        

    print(result)
    return 0

}