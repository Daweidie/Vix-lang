fn lexer(s:string) -> i32 {
    for (i in 0 .. s.length)
    {
        let c = s[i]
        if (c == ' ')
        {
            continue
        }
        else if (c >= '0' && c <= '9')
        {
            print("Number: " + c)
        }
        else if (c == '+' || c == '-' || c == '*' || c == '/')
        {
            print("Operator: " + c)
        }
        else if (c == '=')
        {
            print("Equals: " + c)
        }
        else if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'))
        {
            print("Identifier: " + c)
        }
        else
        {
            print("Unknown: " + c)
        }
    }
    return 0
}
fn main() -> i32 {
    let s = "1 + 1 + 2 = 4"
    lexer(s)
    return 0
}