import "mem.vix"
pub type Result:[T, E] = Ok(T) | Err(E)

extern "C"
{
	fn malloc(size: usize): ptr
	fn strlen(s: ptr): usize
	fn free(ptr: ptr): void
}
fn strconnect(a:ptr,b:ptr): ?ptr
{
	let mut i = 0
	let mut j = 0
	let mut result = malloc(a.length + b.length + 1)
	if(result == 0)
	{
		return None
	}
	while (a[i] != 0)
	{
		result[j] = a[i]
		i += 1
		j += 1
	}
	i = 0
	while (b[i] != 0)
	{
		result[j] = b[i]
		i += 1
		j += 1
	}
	result[j] = 0
	return Some(result)
}
pub fn new_string(src: ptr, len: usize): Result[ptr, ptr]
{
    if (src == 0)
	{
		return Err("Source string is null")
	}
	let dest = malloc(len + 1)
    if (dest == 0)
	{
        return Err("Out of memory")
    }
	copy(dest, src, len)
	for(i in 0 .. len)
	{
		if (dest[i] == 0)
		{
			return Err("Source string is shorter than specified length")
		}
	}
    dest[len] = 0
    return Ok(dest)
}
fn main(): i32
{
	let a = "Hello"
	let b = "World"
	let c = strconnect(a, b)
	match c
	{
		Some(ptr) ->
		{
			print(ptr)
			free(ptr)
		}
		None ->
		{
			print("Failed to concatenate strings")
		}
	}
	let s = new_string("Hello, Vix!", 11)
	match s
	{
		Ok(ptr) ->
		{
			print(ptr)
			free(ptr)
		}
		Err(err) ->
		{
			print(err)
		}
	}
	return 0
}