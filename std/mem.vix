#[no_main]
extern "C"
{
    fn memset(ptr: ptr, value: i32, num: usize) : ptr
    fn memcpy(dest: ptr, src: ptr, num: usize) : ptr
    fn memmove(dest: ptr, src: ptr, num: usize) : ptr
    fn memcmp(ptr1: ptr, ptr2: ptr, num: usize) : i32
}
pub fn set(ptr: ptr, value: i32, num: usize) : ptr
{
    return memset(ptr, value, num)
}
pub fn copy(dest: ptr, src: ptr, num: usize) : ptr
{
    return memcpy(dest, src, num)
}
pub fn move(dest: ptr, src: ptr, num: usize) : ptr
{
    return memmove(dest, src, num)
}
pub fn compare(ptr1: ptr, ptr2: ptr, num: usize) : i32
{
    return memcmp(ptr1, ptr2, num)
}
pub fn zero(ptr: ptr, num: usize) : ptr
{
    return memset(ptr, 0, num)
}