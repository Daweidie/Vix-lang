fn tribonacci(n: i32) -> i32
{
	if (n == 0) {
		return 0
	}
	if (n == 1) {
		return 0
	}
	if (n == 2) {
		return 1
	}
	let a = 0
	let b = 0
	let c = 1
	let i = 3
	while (i <= n) {
		let d = a + b + c
		a = b
		b = c
		c = d
		i = i + 1
	}
	return c
}

fn main(): i32
{
	print(tribonacci(0))
	print(tribonacci(1))
	print(tribonacci(2))
	print(tribonacci(5))
	print(tribonacci(10))
	return 0
}
